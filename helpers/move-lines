#!/usr/bin/env python3
"""move-lines : déplace une plage de lignes d'un fichier vers un autre, sans régénérer le code.

Usage : move-lines [--after N] <src> <start_line> <end_line> <dst>

  Déplace les lignes start_line..end_line (1-indexées, bornes incluses) de <src>
  à la fin de <dst> (créé s'il n'existe pas), ou après la ligne N de <dst> avec --after
  (--after 0 = tout en haut). Les deux fichiers sont écrits via fichier temporaire puis
  remplacés ; en cas d'erreur, aucun des deux n'est modifié.
"""

from __future__ import annotations

import argparse
import os
import sys
import tempfile
from pathlib import Path


def write_atomic(path: Path, content: str) -> str:
    """Écrit `content` dans un temporaire voisin de `path` et retourne son chemin."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    with os.fdopen(fd, "w", newline="") as fh:
        fh.write(content)
    if path.exists():
        os.chmod(tmp, path.stat().st_mode & 0o7777)
    return tmp


def read_lines(path: Path) -> list[str]:
    """Lit un fichier sans traduire les fins de ligne (Path.read_text(newline=) exige Python 3.13)."""
    with path.open(newline="") as fh:
        return fh.read().splitlines(keepends=True)


def main() -> int:
    ap = argparse.ArgumentParser(prog="move-lines", description=__doc__.split("\n\n")[0])
    ap.add_argument("src")
    ap.add_argument("start", type=int)
    ap.add_argument("end", type=int)
    ap.add_argument("dst")
    ap.add_argument("--after", type=int, default=None, help="insère après cette ligne de dst (défaut : fin)")
    args = ap.parse_args()

    src, dst = Path(args.src), Path(args.dst)
    if not src.is_file():
        sys.exit(f"move-lines: fichier source introuvable : {src}")
    if dst.exists() and src.resolve() == dst.resolve():
        sys.exit("move-lines: source et destination identiques")

    src_lines = read_lines(src)
    if not 1 <= args.start <= args.end <= len(src_lines):
        sys.exit(f"move-lines: plage invalide {args.start}-{args.end} (le fichier source a {len(src_lines)} lignes)")
    block = src_lines[args.start - 1 : args.end]
    remaining = src_lines[: args.start - 1] + src_lines[args.end :]

    dst_lines = read_lines(dst) if dst.exists() else []
    pos = len(dst_lines) if args.after is None else args.after
    if not 0 <= pos <= len(dst_lines):
        sys.exit(f"move-lines: --after {pos} hors limites (la destination a {len(dst_lines)} lignes)")
    if block and not block[-1].endswith("\n"):
        block[-1] += "\n"
    if pos > 0 and not dst_lines[pos - 1].endswith("\n"):
        dst_lines[pos - 1] += "\n"
    new_dst = dst_lines[:pos] + block + dst_lines[pos:]

    tmp_dst = write_atomic(dst, "".join(new_dst))
    try:
        tmp_src = write_atomic(src, "".join(remaining))
    except OSError:
        os.unlink(tmp_dst)
        raise
    os.replace(tmp_dst, dst)
    os.replace(tmp_src, src)
    print(f"move-lines: {len(block)} lignes déplacées de {src}:{args.start}-{args.end} vers {dst}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
