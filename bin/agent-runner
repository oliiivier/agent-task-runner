        "model_quota_threshold": {"argon": 60.0},
        "reset_grace_min": 20,
        "usage_refresh_sec": 300,
        "usage_refresh_tasks": 5,
    },
}


class Fail(Exception):
    """Erreur fatale (message affiché, code retour 1)."""


# --------------------------------------------------------------------------- Git
def git(*args: str, cwd: Path, check: bool = True) -> subprocess.CompletedProcess:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise Fail(f"git {' '.join(args)} a échoué : {(proc.stderr or proc.stdout).strip()}")
    return proc


def repo_root() -> Path:
    proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if proc.returncode != 0:
        raise Fail("pas dans un dépôt Git")
    return Path(proc.stdout.strip())


def untracked(root: Path) -> set[str]:
    """Fichiers non suivis et non ignorés (`.agent-tasks/` est ignoré)."""
    out = git("ls-files", "--others", "--exclude-standard", cwd=root, check=False).stdout
    return {ln for ln in out.splitlines() if ln}


def read_tail(path: Path, lines: int = 20) -> str:
    try:
        return "\n".join(path.read_text(errors="replace").splitlines()[-lines:])
    except OSError:
        return ""


def dirty(root: Path) -> str:
    return git("status", "--porcelain", "--untracked-files=no", cwd=root).stdout.strip()


def branch_exists(root: Path, name: str) -> bool:
    return git("show-ref", "--verify", "--quiet", f"refs/heads/{name}", cwd=root, check=False).returncode == 0


# ------------------------------------------------------------------- Frontmatter
def _strip_comment(raw: str) -> str:
    """Retire un commentaire YAML de fin de ligne (` # ...`) hors guillemets."""
    quote = None
    for i, ch in enumerate(raw):
        if quote:
            if ch == quote:
                quote = None
        elif ch in "\"'" and (i == 0 or raw[:i].strip() in ("", "[") or raw[i - 1] in " ,["):
            quote = ch
        elif ch == "#" and (i == 0 or raw[i - 1].isspace()):
            return raw[:i]
    return raw


def _scalar(raw: str):
    raw = _strip_comment(raw).strip()
    if raw == "" or raw in ("null", "~"):
        return None
    if raw in ("true", "True"):
        return True
    if raw in ("false", "False"):
        return False
    if raw.startswith('"'):
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return raw.strip('"')
    if raw.startswith("'") and raw.endswith("'") and len(raw) >= 2:
        return raw[1:-1].replace("''", "'")
    if raw.startswith("["):
        try:
            return json.loads(raw)
        except json.JSONDecodeError:
            return [_scalar(p) for p in raw.strip("[]").split(",") if p.strip()]
    if re.fullmatch(r"-?(0|[1-9]\d*)", raw):  # `01` reste une chaîne (identifiant), pas l'entier 1
        return int(raw)
    if re.fullmatch(r"-?\d+\.\d*", raw):
        return float(raw)
    return raw


def parse_frontmatter(text: str) -> tuple[dict, str]:
    """Sous-ensemble YAML : `clé: valeur` et listes `- item`. Retourne (métadonnées, corps)."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise ValueError("frontmatter manquant (le fichier doit commencer par '---')")
    try:
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
    except StopIteration:
        raise ValueError("frontmatter non terminé (second '---' manquant)") from None
    meta: dict = {}
    key = None
    for raw in lines[1:end]:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        m = re.match(r"^\s+-\s*(.*)$", raw)
        if m and key is not None:
            if not isinstance(meta.get(key), list):
                meta[key] = []
            meta[key].append(_scalar(m.group(1)))
            continue
        m = re.match(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", raw)
        if not m:
            raise ValueError(f"ligne de frontmatter invalide : {raw!r}")
        key = m.group(1)
        value = _strip_comment(m.group(2))
        meta[key] = _scalar(value) if value.strip() else None
    return meta, "\n".join(lines[end + 1 :]).lstrip("\n") + "\n"


# ------------------------------------------------------------------------ Config
def _merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in over.items():
        out[k] = _merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def load_config(root: Path) -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    xdg = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    for path in (xdg / "agent-task-runner" / "config.toml", root / TASKS_DIR / "config.toml"):
        if path.is_file():
            try:
                cfg = _merge(cfg, tomllib.loads(path.read_text()))
            except tomllib.TOMLDecodeError as exc:
                raise Fail(f"{path} : TOML invalide : {exc}") from exc
    return cfg


# -------------------------------------------------------------------------- Task
MERGE_STRATEGIES = ("none", "auto_ff", "auto_no_ff")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
LEVELS = ("N1", "N2", "N3")
FIELDS = {
    "id", "batch", "branch", "base_branch", "merge_strategy", "level", "runner", "prefer_runner",
    "fallback_runner", "model", "effort", "escalate", "allow_premium", "max_model", "verify_cmd",
    "require_commit", "allowed_tools", "max_turns", "timeout_sec", "max_budget_usd",
}


@dataclass
class Task:
    path: Path
    id: str
    branch: str
    body: str
    batch: str = "default"
    base_branch: str = "main"
    merge_strategy: str = "none"
    level: str | None = None
    runner: str = "claude"
    runner_pinned: bool = False
    prefer_runner: str | None = None
    fallback_runner: str | None = None
    fallback_auto: bool = False  # repli déduit (champ absent + auto_fallback), pas écrit dans la fiche
    model: str | None = None
    effort: str | None = None
    escalate: bool = True
    allow_premium: bool = True
    max_model: str | None = None
    verify_cmd: str = ""
    require_commit: bool = True
    allowed_tools: list[str] = field(default_factory=list)
    max_turns: int = 35
    timeout_sec: int = 900
    max_budget_usd: float | None = None


def parse_task(path: Path, cfg: dict) -> Task:
    try:
        meta, body = parse_frontmatter(path.read_text())
        unknown = set(meta) - FIELDS
        if unknown:
            raise ValueError(f"champs inconnus : {', '.join(sorted(unknown))}")
        for req in ("id", "branch"):
            if not meta.get(req):
                raise ValueError(f"champ obligatoire manquant : {req}")

        def get(name, default, typ):
            v = meta.get(name)
            if v is None:
                return default
            if typ is float and isinstance(v, int) and not isinstance(v, bool):
                v = float(v)
            if not isinstance(v, typ) or (typ is int and isinstance(v, bool)):
                raise ValueError(f"{name} : type invalide ({typ.__name__} attendu)")
            return v

        for name in ("id", "batch", "branch"):  # `id: 7` : identifiant numérique, pas un type invalide
            if isinstance(meta.get(name), int) and not isinstance(meta[name], bool):
                meta[name] = str(meta[name])
        tools = meta.get("allowed_tools")
        if tools is None:
            tools = list(cfg["default_allowed_tools"])
        elif not isinstance(tools, list) or not all(isinstance(t, str) for t in tools):
            raise ValueError("allowed_tools : liste de chaînes attendue")
        level = get("level", None, str)
        if level is not None and level not in LEVELS:
            raise ValueError(f"level : {level!r} (attendu : {', '.join(LEVELS)})")
        runner_pinned = meta.get("runner") is not None
        default_r = cfg["default_runner"]
        if not runner_pinned and level:
            lvl_r = cfg.get("routing", {}).get("level_runner", {}).get(level)
            if lvl_r in ADAPTERS:
                default_r = lvl_r
        # La préférence souple prime sur le niveau pour le runner nominal (repli auto et validation du repli).
        if not runner_pinned and meta.get("prefer_runner") in ADAPTERS:
            default_r = meta["prefer_runner"]
        task = Task(
            path=path,
            id=str(get("id", "", str)),
            branch=get("branch", "", str),
            body=body,
            batch=get("batch", "default", str),
            base_branch=get("base_branch", cfg["main_branch"], str),
            merge_strategy=get("merge_strategy", "none", str),
            level=level,
            runner=get("runner", default_r, str),
            runner_pinned=runner_pinned,
            prefer_runner=get("prefer_runner", None, str),
            fallback_runner=get("fallback_runner", None, str),
            model=get("model", None, str),
            effort=get("effort", None, str),
            escalate=get("escalate", True, bool),
            allow_premium=get("allow_premium", True, bool),
            max_model=get("max_model", None, str),
            verify_cmd=get("verify_cmd", cfg["default_verify_cmd"], str),
            require_commit=get("require_commit", True, bool),
            allowed_tools=tools,
            max_turns=get("max_turns", cfg["default_max_turns"], int),
            timeout_sec=get("timeout_sec", cfg["default_timeout_sec"], int),
            max_budget_usd=get("max_budget_usd", None, float),
        )
        if task.merge_strategy not in MERGE_STRATEGIES:
            raise ValueError(f"merge_strategy : {task.merge_strategy!r} (attendu : {', '.join(MERGE_STRATEGIES)})")
        if task.runner not in ADAPTERS:
            raise ValueError(f"runner : {task.runner!r} (attendu : {', '.join(ADAPTERS)})")
        if task.prefer_runner is not None and task.prefer_runner not in ADAPTERS:
            raise ValueError(f"prefer_runner : {task.prefer_runner!r} (attendu : {', '.join(ADAPTERS)})")
        if task.fallback_runner == "none":  # repli explicitement interdit
            task.fallback_runner = None
        elif task.fallback_runner is None:
            if not isinstance(cfg.get("auto_fallback"), bool):
                raise Fail(f"config `auto_fallback` : booléen attendu (reçu {cfg.get('auto_fallback')!r})")
            if cfg["auto_fallback"]:
                task.fallback_runner = next((r for r in ADAPTERS if r != task.runner), None)
                task.fallback_auto = task.fallback_runner is not None
        elif (
            task.fallback_runner not in ADAPTERS or task.fallback_runner == task.runner
        ):
            raise ValueError(f"fallback_runner : {task.fallback_runner!r} (runner différent de {task.runner!r} "
                             f"attendu parmi : {', '.join(ADAPTERS)}, ou `none`)")
        if task.effort is not None and task.effort not in EFFORTS:
            raise ValueError(f"effort : {task.effort!r} (attendu : {', '.join(EFFORTS)})")
        if task.max_turns < 1 or task.timeout_sec < 1:
            raise ValueError("max_turns et timeout_sec doivent être >= 1")
        chain = cfg["escalation"].get(task.runner) or []
        if task.max_model and chain and task.max_model not in chain:
            raise ValueError(f"max_model {task.max_model!r} absent de la chaîne {chain}")
        return task
    except ValueError as exc:
        raise Fail(f"{path.name} : {exc}") from exc


def adapter_for(runner: str, cfg: dict):
    return get_adapter(runner, cfg.get("exclude_models", {}).get(runner))


def map_model(model: str | None, src: list[str], dst: list[str], explicit: dict | None = None) -> str | None:
    """Transpose un modèle d'une chaîne d'escalade vers une autre.

    `explicit` (`[fallback_map.<destination>]`) prime ; sinon rang relatif équivalent, arrondi vers le
    haut : une bascule ne doit pas rétrograder la tâche.
    """
    if model is None or not dst:
        return None
    target = (explicit or {}).get(model)
    if target in dst:
        return target
    if model not in src or len(src) < 2:
        return dst[0]
    rank = src.index(model) * (len(dst) - 1) / (len(src) - 1)
    return dst[min(len(dst) - 1, int(rank + 0.5))]


def level_models(level: str | None, runner: str, cfg: dict) -> tuple[str | None, str | None, str | None]:
    """Retourne (model, max_model, effort_defaut) sur `runner` pour un niveau N1/N2/N3."""
    if not level:
        return None, None, None
    chain = cfg["escalation"].get(runner) or []
    if not chain:
        return None, None, None
    adapter = adapter_for(runner, cfg)
    efforts = {"N1": "low", "N2": "medium", "N3": "high"}
    effort = efforts.get(level)
    matching = [m for m in chain if (adapter.get_model_info(m) or {}).get("level", "").startswith(level)]
    if matching:
        start = matching[0]
        idx = chain.index(start)
        end = chain[min(idx + 1, len(chain) - 1)]
        return start, end, effort
    if level == "N1":
        return chain[0], chain[min(1, len(chain) - 1)], effort
    if level == "N2":
        mid = len(chain) // 2
        return chain[mid], chain[min(mid + 1, len(chain) - 1)], effort
    return chain[-1], chain[-1], effort


def model_quota_status(runner: str, model: str, windows: list | None, cfg: dict) -> tuple[bool, bool]:
    """Retourne (skip_start, skip_all) si le modèle appartient à un groupe de quota dédié (ex. argon)."""
    if not windows:
        return False, False
    info = adapter_for(runner, cfg).get_model_info(model) or {}
    group = info.get("quota_group")
    if not group:
        return False, False
    routing_cfg = cfg.get("routing", {})
    grace_min = float(routing_cfg.get("reset_grace_min", 20.0))
    start_thresh = float(routing_cfg.get("model_quota_threshold", {}).get(group, 60.0))
    hard_thresh = float(routing_cfg.get("quota_threshold", {}).get(runner, 80.0))
    matching = [
        w for w in windows
        if w.name.lower().startswith(group.lower())
        and not (w.reset_minutes is not None and w.reset_minutes <= grace_min and w.utilization < 95.0)
    ]
    if not matching:
        return False, False
    peak = max(w.utilization for w in matching)
    return peak >= start_thresh, peak >= hard_thresh


def candidate_models(task: Task, cfg: dict, forced: str | None, no_escalate: bool,
                     runner: str | None = None, start: str | None = None,
                     windows: list | None = None) -> list[str]:
    """Chaîne de modèles à essayer pour `task` sur `runner` (par défaut son runner nominal).

    Sur le runner de repli, `model`, `max_model` et `--model` sont transposés par `map_model` ;
    `start` permet de reprendre la chaîne au rang déjà atteint lors d'une bascule.
    """
    runner = runner or task.runner
    chain = cfg["escalation"].get(runner) or []
    if not chain:
        raise Fail(f"aucune chaîne d'escalade définie pour le runner {runner!r}")
    model, max_model = task.model, task.max_model
    if task.level and not model:
        lvl_model, lvl_max, _ = level_models(task.level, runner, cfg)
        model = lvl_model
        max_model = max_model or lvl_max
    elif runner != task.runner:
        src = cfg["escalation"].get(task.runner) or []
        explicit = cfg.get("fallback_map", {}).get(runner)
        model, max_model, forced = (map_model(m, src, chain, explicit) for m in (model, max_model, forced))
    effective_start = start or forced or model or chain[0]
    if no_escalate or not task.escalate or effective_start not in chain:
        return [effective_start]
    i = chain.index(effective_start)
    j = chain.index(max_model) if max_model in chain else len(chain) - 1
    queue = chain[i : max(i, j) + 1]
    if not task.allow_premium and not forced and not start and not task.model and len(queue) > 1:
        adapter = adapter_for(runner, cfg)
        non_premium = [m for m in queue if not (adapter.get_model_info(m) or {}).get("premium")]
        if non_premium:
            queue = non_premium
    if windows and len(queue) > 1:
        pinned_start = bool(start or forced or task.model)
        kept = [m for m in queue if not model_quota_status(runner, m, windows, cfg)[1]]
        if kept:
            queue = kept
        if not pinned_start and len(queue) > 1 and model_quota_status(runner, queue[0], windows, cfg)[0]:
            queue = queue[1:]
    return queue


def pick_runner(task: Task, unavailable: set[str], avoid: set[str]) -> str:
    """Runner effectif : le nominal, sauf s'il est indisponible/évité et que le repli est utilisable."""
    alt = task.fallback_runner
    if alt and alt not in unavailable and (task.runner in unavailable or (task.runner in avoid and alt not in avoid)):
        return alt
    return task.runner


def check_runner_quota(runner: str, windows: list | None, cfg: dict) -> tuple[bool, str]:
    """Évalue si un runner dépasse son seuil de quota.

    Les fenêtres dédiées à un groupe de modèle (ex. `argon (7j)`) n'invalident pas tout le runner
    tant que les fenêtres globales (session/semaine) restent disponibles.
    """
    if not windows:
        return False, "usage inconnu"
    routing_cfg = cfg.get("routing", {})
    threshold = float(routing_cfg.get("quota_threshold", {}).get(runner, 80.0))
    grace_min = float(routing_cfg.get("reset_grace_min", 20.0))
    model_groups = {
        g.lower() for g in routing_cfg.get("model_quota_threshold", {})
    }
    active = []
    relaxed = False
    for w in windows:
        if w.reset_minutes is not None and w.reset_minutes <= grace_min and w.utilization < 95.0:
            relaxed = True
            continue
        active.append(w)
    if not active:
        return False, "reset imminent" if relaxed else "usage inconnu"
    runner_windows = [w for w in active if not any(w.name.lower().startswith(g) for g in model_groups)]
    pool = runner_windows or active
    max_w = max(pool, key=lambda w: w.utilization)
    if max_w.utilization >= threshold:
        return True, f"{max_w.name} {max_w.utilization:.0f}% >= {threshold:.0f}%"
    return False, f"{max_w.name} {max_w.utilization:.0f}%"


def resolve_task_routing(
    task: Task,
    cfg: dict,
    unavailable: set[str],
    usage_snapshot: dict[str, list | None],
    avoid: set[str],
    preference_order: list[str],
) -> tuple[str, str]:
    """Résout (runner_effectif, raison) de façon pure.

    Ordre :
    1. Filtre sur les capacités dures (strict_allowed_tools, max_budget_usd).
    2. Runner épinglé (`runner:` explicite) ou préférence par niveau (`[routing.level_runner]`) / défaut.
    3. Seuils de fenêtres d'usage (ignoré si usage indisponible ou runner épinglé).
    """
    candidates = [r for r in preference_order if r not in unavailable and r not in avoid]
    needs_tools = bool(cfg.get("strict_allowed_tools") and task.allowed_tools)
    needs_budget = task.max_budget_usd is not None
    hard_capable = [
        r for r in candidates
        if (not needs_tools or adapter_for(r, cfg).supports_allowed_tools)
        and (not needs_budget or adapter_for(r, cfg).supports_max_budget)
    ]
    pool = hard_capable if hard_capable else candidates

    if task.runner_pinned or (not task.level and not task.prefer_runner):
        base_reason = "pin" if task.runner_pinned else "défaut"
        if task.runner in pool:
            if not task.runner_pinned:
                over, quota_note = check_runner_quota(task.runner, usage_snapshot.get(task.runner), cfg)
                if over and task.fallback_runner and task.fallback_runner in pool:
                    alt_over, _ = check_runner_quota(task.fallback_runner, usage_snapshot.get(task.fallback_runner), cfg)
                    if not alt_over:
                        return task.fallback_runner, f"{base_reason}, bascule ({task.runner}: {quota_note})"
                if quota_note == "usage inconnu":
                    return task.runner, f"{base_reason}, usage inconnu"
            return task.runner, base_reason
        if task.runner in candidates and not hard_capable:
            return task.runner, base_reason
        if needs_tools and not adapter_for(task.runner, cfg).supports_allowed_tools and pool:
            return pool[0], "contrainte allowed_tools"
        if needs_budget and not adapter_for(task.runner, cfg).supports_max_budget and pool:
            return pool[0], "contrainte budget"
        alt = task.fallback_runner
        if alt and alt in pool:
            return alt, f"repli ({task.runner} indisponible)"
        return task.runner, "indisponible"

    level_pref = (
        task.prefer_runner
        or (cfg.get("routing", {}).get("level_runner", {}).get(task.level) if task.level else None)
        or cfg.get("default_runner")
    )
    if level_pref in pool:
        preferred = level_pref
        if task.prefer_runner:
            base_reason = f"préférence {task.prefer_runner}" + (f" ({task.level})" if task.level else "")
        else:
            base_reason = f"niveau {task.level}" if task.level else "défaut"
    elif pool:
        preferred = pool[0]
        if needs_tools and level_pref and not adapter_for(level_pref, cfg).supports_allowed_tools:
            base_reason = "contrainte allowed_tools"
        elif needs_budget and level_pref and not adapter_for(level_pref, cfg).supports_max_budget:
            base_reason = "contrainte budget"
        else:
            base_reason = f"{level_pref} indisponible -> {preferred}"
    else:
        return task.runner, "indisponible"

    over, quota_note = check_runner_quota(preferred, usage_snapshot.get(preferred), cfg)
    if over:
        for alt in pool:
            if alt == preferred:
                continue
            alt_over, _ = check_runner_quota(alt, usage_snapshot.get(alt), cfg)
            if not alt_over:
                return alt, f"{base_reason}, bascule ({preferred}: {quota_note})"
        return preferred, f"{base_reason} ({quota_note}, sans alternative)"
    if quota_note == "usage inconnu":
        return preferred, f"{base_reason}, usage inconnu"
    return preferred, base_reason


class UsageCache:
    """Cliché d'usage avec rafraîchissement paresseux (temps, N tâches ou erreur de quota)."""

    def __init__(self, cfg: dict, runners: list[str], status: dict[str, str | None]) -> None:
        self.cfg = cfg
        self.runners = [r for r in runners if not status.get(r)]
        routing_cfg = cfg.get("routing", {})
        self.min_interval = float(routing_cfg.get("usage_refresh_sec", 300))
        self.task_interval = int(routing_cfg.get("usage_refresh_tasks", 5))
        self.snapshot: dict[str, list | None] = {}
        self.last_fetch: float = 0.0
        self.tasks_since_fetch: int = 0
        self.refresh(force=True)

    def refresh(self, force: bool = False) -> None:
        now = time.monotonic()
        if not force:
            if (now - self.last_fetch) < self.min_interval or self.tasks_since_fetch < self.task_interval:
                return
        for r in self.runners:
            try:
                self.snapshot[r] = adapter_for(r, self.cfg).get_usage_windows()
            except Exception:
                self.snapshot[r] = None
        self.last_fetch = now
        self.tasks_since_fetch = 0

    def on_task_done(self, quota_hit: bool = False) -> None:
        self.tasks_since_fetch += 1
        if quota_hit:
            if (time.monotonic() - self.last_fetch) >= min(30.0, self.min_interval):
                self.refresh(force=True)
        else:
            self.refresh(force=False)


def load_queue(tasks_dir: Path, cfg: dict, batch: str | None) -> list[Task]:
    tasks = [parse_task(p, cfg) for p in sorted((tasks_dir / "todo").glob("*.md"))]
    seen: set[str] = set()
    for t in tasks:
        if t.id in seen:
            raise Fail(f"id de tâche en double : {t.id}")
        seen.add(t.id)
    return [t for t in tasks if batch is None or t.batch == batch]


def validate_queue(root: Path, cfg: dict, tasks: list[Task]) -> None:
    """Cohérence des tâches et des lots, vérifiée avant toute exécution (y compris --dry-run)."""
    errors: list[str] = []
    by_batch: dict[str, list[Task]] = {}
    created: set[str] = set()  # branches créées par les tâches précédentes de la file
    for t in tasks:
        name = t.path.name
        if t.merge_strategy != "none" and t.branch == t.base_branch:
            errors.append(f"{name} : branch == base_branch ({t.branch}) incompatible avec merge_strategy={t.merge_strategy}")
        if not (branch_exists(root, t.base_branch) or t.base_branch in created) and not branch_exists(root, t.branch):
            errors.append(f"{name} : base_branch {t.base_branch!r} introuvable")
        created.add(t.branch)
        by_batch.setdefault(t.batch, []).append(t)
    for batch, members in by_batch.items():
        if all(m.merge_strategy == "none" for m in members):
            continue  # lot sans fusion automatique : les tâches restent indépendantes
        ref = members[0]
        for t in members[1:]:
            for attr in ("branch", "base_branch", "merge_strategy"):
                if getattr(t, attr) != getattr(ref, attr):
                    errors.append(f"{t.path.name} : {attr}={getattr(t, attr)!r} diffère de {ref.path.name} "
                                  f"({getattr(ref, attr)!r}) dans le lot {batch!r} (fusion automatique)")
    if errors:
        raise Fail("incohérences dans la file :\n  " + "\n  ".join(errors))


def check_fallback_map(cfg: dict, tasks: list[Task], catalogs: dict) -> None:
    """Avertit si un repli probable cible un modèle absent de la chaîne ou du catalogue du runner de destination."""
    warned: set[tuple[str, str]] = set()
    for t in tasks:
        alt = t.fallback_runner
        if not alt:
            continue
        chain = cfg["escalation"].get(alt) or []
        explicit = cfg.get("fallback_map", {}).get(alt) or {}
        for m in filter(None, (t.model, t.max_model)):
            target = explicit.get(m)
            if target is None:
                continue
            problem = ("absent de [escalation]." + alt if target not in chain
                       else "absent du catalogue" if alt in catalogs and not in_catalog(target, catalogs[alt])
                       else "")
            if problem and (alt, target) not in warned:
                warned.add((alt, target))
                print(f"avertissement : [fallback_map.{alt}] {m!r} -> {target!r} : {problem} "
                      f"(rang équivalent utilisé à défaut)", file=sys.stderr)


def apply_strict_allowed_tools(cfg: dict, tasks: list[Task]) -> None:
    """strict_allowed_tools : pas de repli vers un runner qui ignore `allowed_tools`."""
    if not cfg.get("strict_allowed_tools"):
        return
    for t in tasks:
        alt = t.fallback_runner
        if not (t.allowed_tools and alt and adapter_for(t.runner, cfg).supports_allowed_tools
                and not adapter_for(alt, cfg).supports_allowed_tools):
            continue
        if not t.fallback_auto:
            raise Fail(f"{t.path.name} : fallback_runner {alt!r} n'applique pas allowed_tools "
                       "(strict_allowed_tools = true)")
        t.fallback_runner, t.fallback_auto = None, False


# ------------------------------------------------------------------------ Prompt
def _recent_task_logs(root: Path, task_id: str, limit: int = 4) -> list[str]:
    """Retourne les chemins relatifs des derniers `.verify.log` / `.log` d'une tâche."""
    logs_dir = root / TASKS_DIR / "logs"
    if not logs_dir.is_dir():
        return []
    matches = [p for p in logs_dir.glob(f"{task_id}.try*") if p.suffix == ".log"]
    matches.sort(key=lambda p: (p.stat().st_mtime, p.name), reverse=True)
    return [f"{TASKS_DIR}/logs/{p.name}" for p in matches[:limit]]


def build_prompt(task: Task, root: Path, k: int, prev: dict | None, partial: str, head_before: str = "") -> str:
    parts = [
        f"Tu exécutes UNE tâche d'une file automatisée (id : {task.id}, branche {task.branch}, "
        "déjà checkoutée). Lis CLAUDE.md s'il existe."
    ]
    recent_logs = _recent_task_logs(root, task.id) if (prev or partial) else []
    logs_hint = (
        "Journaux précédents disponibles en lecture seule : " + ", ".join(recent_logs) + " "
        "(consulte-les ainsi que tout fichier de log détaillé indiqué par un script de vérification en mode quiet).\n"
        if recent_logs else ""
    )
    if prev:
        status = git("status", "--short", cwd=root).stdout.strip() or "(arbre propre)"
        stat = git("diff", "--stat", "HEAD", cwd=root).stdout.strip() or "(aucune différence)"
        committed = ""
        if head_before and git("rev-parse", "HEAD", cwd=root).stdout.strip() != head_before:
            log = git("log", "--oneline", f"{head_before}..HEAD", cwd=root, check=False).stdout.strip()
            cstat = git("diff", "--stat", f"{head_before}..HEAD", cwd=root, check=False).stdout.strip()
            committed = (f"Commits déjà créés par les tentatives précédentes (git log --oneline) :\n{log}\n"
                         f"git diff --stat {head_before[:8]}..HEAD :\n{cstat}\n")
        parts.append(
            f"ESCALADE : la tentative {k - 1} ({prev['model']}) a échoué.\n"
            f"Motif : {prev['reason']}\n"
            + (f"Sortie de la vérification :\n{prev['verify_tail']}\n" if prev.get("verify_tail") else "")
            + (f"Dernière sortie de l'agent :\n{prev['agent_tail']}\n" if prev.get("agent_tail") else "")
            + logs_hint
            + f"État actuel du dépôt (travail partiel CONSERVÉ — reprends-le, ne recommence pas) :\n"
            f"git status --short :\n{status}\ngit diff --stat HEAD :\n{stat}\n"
            + committed
            + "Corrige directement le blocage."
        )
    elif partial:
        parts.append(
            "REPRISE : une exécution précédente de cette tâche a été interrompue. L'arbre contient "
            f"son travail partiel non commité :\n{partial}\n"
            + logs_hint
            + "Inspecte-le (git diff) et termine-le plutôt que de recommencer ; ne l'annule que s'il est incohérent."
        )
    parts.append("## Tâche\n\n" + task.body.strip())
    commit_rule = (
        f"Une fois `{task.verify_cmd}` passé avec succès, crée UN seul commit, message en anglais au format conventionnel."
        if (task.require_commit and task.verify_cmd)
        else "Crée UN seul commit, message en anglais au format conventionnel."
        if task.require_commit
        else "Ne crée aucun commit : cette tâche ne modifie pas le dépôt (audit/baseline)."
    )
    rules = [
        "Réalise cette tâche, et uniquement elle (les tâches précédentes sont déjà commitées, "
        "les suivantes ne te concernent pas).",
        "Modifie les fichiers avec Edit/Write ; pour repérer des plages de lignes sans lire un fichier entier, "
        "utilise `file-outline <fichier>` ; pour déplacer un gros bloc de lignes entre fichiers, "
        "utilise `move-lines <src> <début> <fin> <dst>` plutôt que de réécrire le code.",
        "Ne modifie jamais .agent-tasks/ (lecture seule sur .agent-tasks/logs/ autorisée pour diagnostic) "
        "et n'écris rien hors du dépôt.",
        "Si tu es bloqué, ne commite rien de cassé et explique le blocage.",
    ]
    if task.verify_cmd:
        rules.insert(1, f"Avant de commiter, exécute `{task.verify_cmd}` et corrige jusqu'au succès "
                        "(le runner la réexécutera après ton travail ; si un script de check est en mode quiet/`-q` "
                        "et échoue sans détail, lis le fichier de log d'erreur qu'il indique ou relance-le sans `-q`).")
        rules.insert(2, commit_rule)
    else:
        rules.insert(1, commit_rule)
    parts.append("## Règles d'exécution\n\n" + "\n".join(f"- {r}" for r in rules))
    return "\n\n".join(parts)


# ----------------------------------------------------------------------- Logging
def log_usage(logs: Path, task: Task, k: int, runner: str, model: str, res, status: str) -> None:
    path = logs / "usage.tsv"
    new = not path.exists()
    row = [
        datetime.now(timezone.utc).isoformat(timespec="seconds"), task.batch, task.id, k, runner,
        model, res.turns, res.tokens_in, res.cache_write, res.cache_read, res.tokens_out,
        f"{res.cost_usd:.4f}", f"{res.duration_sec:.0f}", status,
    ]
    with path.open("a") as fh:
        if new:
            fh.write("\t".join(USAGE_HEADER) + "\n")
        fh.write("\t".join(str(c) for c in row) + "\n")


def tail(text: str, n: int = 4000) -> str:
    return text if len(text) <= n else "[...]\n" + text[-n:]


# --------------------------------------------------------------------- Exécution
def evaluate(task: Task, root: Path, res, head_before: str, log_base: Path) -> tuple[str, str, str]:
    """Valide C1..C4. Retourne (statut, motif, extrait de sortie de verify_cmd)."""
    if res.error:  # C1
        code = ("quota" if res.quota_hit else "timeout" if res.timed_out
                else "max_turns" if res.max_turns_hit else "error")
        return code, res.error, ""
    if dirty(root):  # C2
        return "dirty", "fichiers suivis modifiés non commités après l'exécution", ""
    if task.require_commit and git("rev-parse", "HEAD", cwd=root).stdout.strip() == head_before:  # C3
        return "no_commit", "HEAD n'a pas avancé (require_commit=true)", ""
    if task.verify_cmd:  # C4
        try:
            proc = subprocess.run(task.verify_cmd, shell=True, cwd=root, capture_output=True,
                                  text=True, errors="replace", timeout=task.timeout_sec)
            out, rc = (proc.stdout + proc.stderr), proc.returncode
        except subprocess.TimeoutExpired as exc:
            out = (exc.stdout or b"").decode(errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
            rc = None
        Path(f"{log_base}.verify.log").write_text(out)
        if rc != 0:
            why = "timeout" if rc is None else f"code retour {rc}"
            return "verify_failed", f"verify_cmd en échec ({why}) : {task.verify_cmd}", tail(out)
    return "success", "", ""


def execute_task(root: Path, cfg: dict, task: Task, args, allow_dirty: bool, progress: str = "") -> bool:
    tasks_dir = root / TASKS_DIR
    logs = tasks_dir / "logs"
    logs.mkdir(exist_ok=True)

    current = git("branch", "--show-current", cwd=root).stdout.strip()
    is_dirty = dirty(root)
    if is_dirty and not allow_dirty:
        raise Fail("arbre de travail non propre (fichiers suivis modifiés) : commit/stash, ou --resume pour reprendre")
    if is_dirty and current != task.branch:
        raise Fail(f"--resume : l'arbre modifié n'est pas sur {task.branch} (actuellement {current or 'HEAD détaché'})")
    if branch_exists(root, task.branch):
        git("checkout", task.branch, cwd=root)
    else:
        git("checkout", "-b", task.branch, task.base_branch, cwd=root)
    head_before = git("rev-parse", "HEAD", cwd=root).stdout.strip()
    partial = git("status", "--short", cwd=root).stdout.strip() if is_dirty else ""

    unavailable: set[str] = args.unavailable  # partagé entre tâches : un quota atteint vaut pour la suite
    all_unavailable = unavailable | {r for r, why in getattr(args, "status", {}).items() if why}
    runner, routing_reason = resolve_task_routing(
        task, cfg, all_unavailable, args.usage_cache.snapshot,
        set(args.avoid_runner or []), args.preference,
    )
    if runner in all_unavailable:
        raise Fail(f"{task.id} : runner {runner!r} indisponible (quota ou exécutable absent) et aucun "
                   "fallback_runner utilisable")
    effective_effort = task.effort or (level_models(task.level, runner, cfg)[2] if task.level else None)
    queue = candidate_models(task, cfg, args.model, args.no_escalate, runner,
                             windows=args.usage_cache.snapshot.get(runner))
    attempts: list[dict] = []
    prev: dict | None = None
    note = f" (repli de {task.runner})" if runner != task.runner else ""
    print(_ansi("1", f"=== {progress}{task.id}") + _ansi("2", f" [{task.batch}] branche {task.branch}")
          + f" — {_ansi('32', runner)}{note} [{routing_reason}] : {' -> '.join(queue)}")

    k = 0
    while queue:
        model = queue.pop(0)
        k += 1
        if prev and prev["status"] != "quota":
            print(_ansi("36", f"    escalade {prev['model']} -> {model}"))
        adapter = adapter_for(runner, cfg)
        try:
            model_id = adapter.resolve_model(model, effective_effort, args.catalogs.get(runner))
        except ValueError as exc:
            raise Fail(f"{task.id} : {exc}") from exc
        safe = re.sub(r"[^\w.-]", "_", f"{runner}-{model_id}" if runner != task.runner else model_id)
        log_base = logs / f"{task.id}.try{k}-{safe}"
        req = RunRequest(
            prompt=build_prompt(task, root, k, prev, partial if k == 1 else "", head_before),
            model=model_id, cwd=root, allowed_tools=task.allowed_tools, max_turns=task.max_turns,
            timeout_sec=task.timeout_sec, max_budget_usd=task.max_budget_usd,
            permission_mode=cfg["permission"], effort=effective_effort,
            extra_args=list(cfg.get("extra_args", {}).get(runner, [])),
        )
        shown = model_id if model_id != model else model + (f" (effort {effective_effort})" if effective_effort else "")
        print(f"    tentative {k} : {_ansi('1', f'{runner} {shown}')} ...", flush=True)
        untracked_before = untracked(root)
        res = adapter.run(req, Path(f"{log_base}.log"), Path(f"{log_base}.json"))
        status, reason, verify_tail = evaluate(task, root, res, head_before, log_base)
        new_files = sorted(untracked(root) - untracked_before)
        if new_files:
            shown_files = ", ".join(new_files[:10]) + (f" (+{len(new_files) - 10})" if len(new_files) > 10 else "")
            print(_ansi("33", f"    ! fichiers non suivis laissés par l'agent (oubli de `git add` ?) : {shown_files}",
                        sys.stderr), file=sys.stderr)
        log_usage(logs, task, k, runner, model_id, res, status)
        st_color = "1;32" if status == "success" else "33" if status in ("quota", "max_turns", "timeout") else "1;31"
        metrics = f"(tours={res.turns}, coût=${res.cost_usd:.2f}, {_fmt_dur(res.duration_sec)})"
        print(f"    -> {_ansi(st_color, status)}" + (f" : {reason}" if reason else "") + "  " + _ansi("2", metrics))
        attempts.append({"k": k, "model": f"{runner} {model_id}", "status": status, "reason": reason})
        if status == "success":
            shutil.move(str(task.path), str(tasks_dir / "done" / task.path.name))
            return True
        agent_tail = ""
        if status != "verify_failed":  # C1/C2/C3 : sans sortie de verify_cmd, donner la fin du travail de l'agent
            agent_tail = tail(res.result_text.strip() or read_tail(Path(f"{log_base}.log")), 1500)
        prev = {"model": f"{runner} {model_id}", "status": status, "reason": reason,
                "verify_tail": verify_tail, "agent_tail": agent_tail}
        if res.permission_denied:
            print(_ansi("1;31", f"    ! {runner} a refusé une commande en mode headless : passer "
                        '`permission = "bypass"` dans config.toml ou configurer permissions.allow dans settings.json.',
                        sys.stderr), file=sys.stderr)
            break
        if status == "quota":
            # Le fournisseur est saturé : inutile d'escalader chez lui. On bascule sur le repli en
            # reprenant au rang équivalent, et on le marque indisponible pour les tâches suivantes.
            args.last_quota_hit = True
            unavailable.add(runner)
            alt = task.fallback_runner if task.fallback_runner not in unavailable else None
            if alt is None or runner == alt:
                print(_ansi("1;31", f"    quota {runner} atteint, aucun runner de repli disponible.", sys.stderr),
                      file=sys.stderr)
                break
            src = cfg["escalation"].get(runner) or []
            dst = cfg["escalation"].get(alt) or []
            start = map_model(model, src, dst, cfg.get("fallback_map", {}).get(alt))
            queue = candidate_models(task, cfg, args.model, args.no_escalate, alt, start=start,
                                     windows=args.usage_cache.snapshot.get(alt))
            print(_ansi("33", f"    bascule {runner} -> {alt} : {' -> '.join(queue)}"))
            runner = alt

    # Échec définitif
    if not args.continue_on_error:
        print(_ansi("1;31", f"    ÉCHEC de {task.id} : tâche laissée dans todo/ avec l'état partiel (--resume pour reprendre).",
                    sys.stderr), file=sys.stderr)
        return False
    git("reset", "--hard", head_before, cwd=root)
    git("clean", "-fd", "-e", TASKS_DIR, cwd=root)
    report = [f"\n{FAILURE_MARKER}", "## Rapport d'échec (agent-runner)", ""]
    for a in attempts:
        report.append(f"- Tentative {a['k']} ({a['model']}) : {a['status']} — {a['reason']}")
    if prev and prev.get("verify_tail"):
        report += ["", "Dernière sortie de verify_cmd :", "```", prev["verify_tail"], "```"]
    with task.path.open("a") as fh:
        fh.write("\n".join(report) + "\n")
    shutil.move(str(task.path), str(tasks_dir / "failed" / task.path.name))
    print(_ansi("1;31", f"    ÉCHEC de {task.id} : arbre réinitialisé, tâche déplacée vers failed/.", sys.stderr),
          file=sys.stderr)
    return False


def _extract_objective(body: str) -> str:
    """Extrait la première ligne utile sous `## Objectif` dans le corps d'une fiche."""
    in_obj = False
    for line in body.splitlines():
        s = line.strip()
        if s.lower().startswith("## objectif"):
            in_obj = True
            continue
        if in_obj:
            if s.startswith("## "):
                break
            if s and s != "...":
                return s.lstrip("- ").strip()
    return ""


def build_merge_message(root: Path, batch: str, tasks: list[Task], branch: str, base_branch: str) -> str:
    """Construit un message de merge déterministe et structuré à partir des fiches terminées."""
    lines = [f"merge(batch): {batch} ({len(tasks)} task(s))", ""]
    for t in tasks:
        obj = _extract_objective(t.body)
        lines.append(f"- {t.id}: {obj}" if obj else f"- {t.id}")
    commits = git("log", "--oneline", f"{base_branch}..{branch}", cwd=root, check=False).stdout.strip()
    if commits:
        n_commits = len(commits.splitlines())
        lines += ["", f"Branch: {branch} -> {base_branch} ({n_commits} commit(s))"]
    return "\n".join(lines)


def merge_batch_branch(
    root: Path, tasks_dir: Path, batch: str, branch: str, base_branch: str, strategy: str,
    message: str | None = None, delete_branch: bool = True, force: bool = False,
) -> int:
    """Fusionne `branch` dans `base_branch` après vérification du lot et propreté de l'arbre."""
    if not force:
        remaining = []
        for folder in ("todo", "failed"):
            for p in sorted((tasks_dir / folder).glob("*.md")):
                try:
                    meta, _ = parse_frontmatter(p.read_text())
                except ValueError:
                    continue
                if meta.get("batch", "default") == batch:
                    remaining.append(f"{folder}/{p.name}")
        if remaining:
            print(f"lot {batch} : non finalisé, tâches restantes : {', '.join(remaining)}", file=sys.stderr)
            return 1
    if dirty(root):
        print(f"lot {batch} : merge impossible, arbre non propre", file=sys.stderr)
        return 1
    if branch == base_branch:
        print(f"lot {batch} : branch == base_branch ({branch}), rien à fusionner.", file=sys.stderr)
        return 1
    if not branch_exists(root, branch):
        print(f"lot {batch} : branche {branch!r} introuvable.", file=sys.stderr)
        return 1
    if not branch_exists(root, base_branch):
        print(f"lot {batch} : base_branch {base_branch!r} introuvable.", file=sys.stderr)
        return 1

    git("checkout", base_branch, cwd=root)
    if strategy in ("ff", "auto_ff"):
        proc = git("merge", "--ff-only", branch, cwd=root, check=False)
    elif strategy == "squash":
        proc = git("merge", "--squash", branch, cwd=root, check=False)
        if proc.returncode == 0:
            proc = git("commit", "-m", message or f"merge(batch): {batch}", cwd=root, check=False)
    else:  # no-ff | auto_no_ff
        cmd = ["merge", "--no-ff"] + (["-m", message] if message else ["--no-edit"]) + [branch]
        proc = git(*cmd, cwd=root, check=False)

    if proc.returncode != 0:
        git("merge", "--abort", cwd=root, check=False)
        if strategy == "squash":
            git("reset", "--hard", "HEAD", cwd=root, check=False)
        print(f"lot {batch} : merge {strategy} de {branch} dans {base_branch} impossible "
              f"(branche conservée) : {(proc.stderr or proc.stdout).strip()}", file=sys.stderr)
        return 1

    if delete_branch:
        git("branch", "-D" if strategy == "squash" else "-d", branch, cwd=root)
        print(f"lot {batch} : {branch} fusionnée dans {base_branch} ({strategy}), branche supprimée.")
    else:
        print(f"lot {batch} : {branch} fusionnée dans {base_branch} ({strategy}), branche conservée.")
    return 0


def finalize_batches(root: Path, cfg: dict, completed: list[Task]) -> int:
    tasks_dir = root / TASKS_DIR
    by_batch: dict[str, list[Task]] = {}
    for t in completed:
        by_batch.setdefault(t.batch, []).append(t)
    rc = 0
    for batch, batch_tasks in by_batch.items():
        t = batch_tasks[-1]
        if t.merge_strategy == "none":
            continue
        remaining = []
        for folder in ("todo", "failed"):
            for p in sorted((tasks_dir / folder).glob("*.md")):
                try:
                    meta, _ = parse_frontmatter(p.read_text())
                except ValueError:
                    continue
                if meta.get("batch", "default") == batch:
                    remaining.append(f"{folder}/{p.name}")
        if remaining:
            print(f"lot {batch} : non finalisé, tâches restantes : {', '.join(remaining)}")
            continue
        msg = build_merge_message(root, batch, batch_tasks, t.branch, t.base_branch) if t.merge_strategy == "auto_no_ff" else None
        if merge_batch_branch(root, tasks_dir, batch, t.branch, t.base_branch, t.merge_strategy,
                              message=msg, delete_branch=True, force=True) != 0:
            rc = 1
    return rc


def enabled_runners(cfg: dict) -> list[str]:
    runners = cfg.get("runners")
    if not isinstance(runners, list) or not all(r in ADAPTERS for r in runners):
        raise Fail(f"config `runners` : liste attendue parmi {', '.join(ADAPTERS)} (reçu {runners!r})")
    return runners


def probe_runners(cfg: dict, runners) -> tuple[dict[str, str | None], dict[str, dict[str, list[str]]]]:
    """Disponibilité de chaque runner (None si utilisable, sinon le motif) et catalogues de modèles.

    Un runner est utilisable s'il est autorisé par `runners`, présent dans le PATH et connecté.
    Interroge les CLI une seule fois (le catalogue agy sert aussi de test de connexion).
    """
    enabled = enabled_runners(cfg)
    status: dict[str, str | None] = {}
    catalogs: dict[str, dict[str, list[str]]] = {}
    for runner in sorted(runners):
        adapter = adapter_for(runner, cfg)
        if runner not in enabled:
            status[runner] = "désactivé par `runners` dans config.toml"
        elif not shutil.which(adapter.executable):
            status[runner] = f"{adapter.executable} introuvable dans le PATH"
        else:
            status[runner], catalog = adapter.probe()
            if catalog is not None:
                catalogs[runner] = catalog
    return status, catalogs


def in_catalog(model: str, catalog: dict) -> bool:
    """Modèle présent au catalogue, tel quel ou sous forme `<famille>-<effort>`."""
    return model in catalog or model.rsplit("-", 1)[0] in catalog


def check_models(cfg: dict, tasks: list[Task], catalogs: dict) -> None:
    """Retire des chaînes les modèles absents du catalogue ; échoue si une tâche en dépend directement."""
    for runner, catalog in catalogs.items():
        chain = cfg["escalation"].get(runner) or []
        missing = [m for m in chain if not in_catalog(m, catalog)]
        if not missing:
            continue
        print(f"avertissement : [escalation].{runner} contient des modèles absents du catalogue "
              f"({', '.join(missing)}) ; ignorés. Voir `agent-runner models`.", file=sys.stderr)
        cfg["escalation"][runner] = [m for m in chain if m not in missing]
        for t in tasks:
            if t.runner == runner and (t.model in missing or t.max_model in missing):
                raise Fail(f"{t.path.name} : modèle {runner} indisponible ({t.model or t.max_model}) ; "
                           "corriger la fiche ou [escalation]")


def cmd_models(args) -> int:
    """Affiche, par runner, la chaîne configurée, les capacités et le catalogue réellement disponible."""
    try:
        cfg = load_config(repo_root())
    except Fail:
        cfg = json.loads(json.dumps(DEFAULTS))
    runners = [args.runner] if args.runner else sorted(ADAPTERS)
    status, catalogs = probe_runners(cfg, runners)
    ok = [r for r in runners if not status[r]]
    print(f"runners disponibles : {', '.join(ok) or 'aucun'}")
    for r in runners:
        if status[r]:
            print(f"runner indisponible : {r} ({status[r]})")
    print(f"default_runner : {cfg['default_runner']}\n")
    for runner in runners:
        adapter = adapter_for(runner, cfg)
        chain = cfg["escalation"].get(runner) or []
        disp_status = _ansi("32", "(disponible)") if not status[runner] else _ansi("33", "(indisponible)")
        print(_ansi("1;36", f"[{runner}]") + f" {disp_status}")
        windows = None
        try:
            windows = adapter.get_usage_windows()
        except Exception:
            pass
        if windows:
            parts = []
            for w in windows:
                color = "32" if w.utilization < 50 else ("33" if w.utilization < 80 else "1;31")
                reset_info = f" (reset dans {w.reset_delay})" if w.reset_delay else ""
                parts.append(f"{w.name}: {_ansi(color, f'{w.utilization:.0f}%')}{reset_info}")
            print(_ansi("1;35", "  fenêtres d'usage : ") + " | ".join(parts))
        else:
            print(_ansi("2", "  fenêtres d'usage : non disponible (nécessite un compte OAuth connecté)"))
        tools_st = "oui" if adapter.supports_allowed_tools else "non"
        turns_st = "oui" if adapter.supports_max_turns and runner == "claude" else ("partiel" if runner == "codex" else "non")
        budget_st = "oui" if adapter.supports_max_budget else "non"
        print(_ansi("2", f"  capacités        : allowed_tools: {tools_st} | max_turns: {turns_st} | max_budget: {budget_st} | timeout: oui"))
        if adapter.recommended_usage:
            print(_ansi("2", f"  usage recommandé : {adapter.recommended_usage}"))
        print(f"  chaîne           : {' -> '.join(chain) or '-'}")
        if adapter.exclude:
            print(_ansi("2", f"  exclus           : {', '.join(adapter.exclude)}"))
        if status[runner]:
            print(_ansi("33", f"  motif indispo    : {status[runner]}"))
        if chain:
            print(_ansi("2", "  modèles configurés :"))
            for m in chain:
                info = adapter.get_model_info(m)
                if info:
                    meta = _ansi("2", f"[{info['level']:<4} | {info['context']:<4} | {info['cost']:<4}]")
                    desc = info.get("desc", "")
                    print(f"    * {m:<18} {meta} {desc}")
                else:
                    print(f"    * {m}")
        catalog = catalogs.get(runner)
        if catalog is not None:
            print(_ansi("2", f"  catalogue ({runner} models) :"))
            for family, efforts in catalog.items():
                mark = _ansi("32", "*") if family in chain else " "
                print(f"  {mark} {family:<34} {_ansi('2', ', '.join(efforts) or '(sans effort)')}")
            for m in chain:
                if not in_catalog(m, catalog):
                    print(_ansi("1;31", f"  ! {m} : absent du catalogue"))
        elif not status[runner]:
            print(_ansi("2", "  (pas de catalogue exposé par le CLI : alias de la chaîne utilisés tels quels)"))
        print()
    return 0


def _ansi(code: str, text: str, stream=None) -> str:
    """Applique un style ANSI uniquement sur un terminal interactif (et sans NO_COLOR)."""
    target = stream or sys.stdout
    if target.isatty() and not os.environ.get("NO_COLOR"):
        return f"\033[{code}m{text}\033[0m"
    return text


def _fmt_int(n: int | float) -> str:
    return f"{int(n):,}".replace(",", " ")


def _fmt_dur(sec: float) -> str:
    s = int(sec)
    return f"{s}s" if s < 60 else f"{s // 60}m{s % 60:02d}s"


def print_dry_run(tasks: list[Task], cfg: dict, args, status: dict[str, str | None], avoid: set[str]) -> None:
    """Affiche le plan d'exécution (--dry-run) regroupé par lot/branche, avec alignement et couleurs TTY."""
    print(_ansi("1", f"Plan d'exécution : {len(tasks)} tâche(s)"))
    name_w = min(max(len(t.path.name) for t in tasks), 36)
    last_group: tuple[str, str, str, str] | None = None
    all_unavailable = args.unavailable | {r for r, why in status.items() if why}
    for t in tasks:
        runner, routing_reason = resolve_task_routing(
            t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, args.preference
        )
        adapter = adapter_for(runner, cfg)
        effective_effort = t.effort or (level_models(t.level, runner, cfg)[2] if t.level else None)
        try:
            chain = [adapter.resolve_model(m, effective_effort, args.catalogs.get(runner))
                     for m in candidate_models(t, cfg, args.model, args.no_escalate, runner,
                                               windows=args.usage_cache.snapshot.get(runner))]
        except ValueError as exc:
            raise Fail(f"{t.id} : {exc}") from exc
        group = (t.batch, t.branch, t.base_branch, t.merge_strategy)
        if group != last_group:
            last_group = group
            print()
            print(_ansi("1;36", f"[{t.batch}]") + f"  branche {_ansi('1', t.branch)} <- {t.base_branch}  "
                  + _ansi("2", f"(merge: {t.merge_strategy})"))
        notes: list[str] = []
        if t.fallback_runner and t.fallback_runner != runner:
            notes.append(_ansi("2", f"(repli {'auto ' if t.fallback_auto else ''}{t.fallback_runner})"))
        elif runner != t.runner:
            notes.append(_ansi("2", f"(au lieu de {t.runner}{', repli auto' if t.fallback_auto else ''})"))
        notes.append(_ansi("2", f"[{routing_reason}]"))
        if runner in args.unavailable:
            notes.append(_ansi("1;31", f"[INDISPONIBLE : {status[runner]}]"))
        if t.allowed_tools:
            if not adapter.supports_allowed_tools:
                notes.append(_ansi("33", "[sans restriction d'outils]"))
            elif t.fallback_runner and not adapter_for(t.fallback_runner, cfg).supports_allowed_tools:
                notes.append(_ansi("33", f"[repli {t.fallback_runner} : sans restriction d'outils]"))
        suffix = ("  " + " ".join(notes)) if notes else ""
        print(f"  {t.path.name:<{name_w}}  {_ansi('32', f'{runner:<6}')}  {' -> '.join(chain)}{suffix}")
        meta = []
        if t.level:
            meta.append(f"level={t.level}")
        if effective_effort:
            meta.append(f"effort={effective_effort}")
        meta.append(f"max_turns={t.max_turns}")
        if t.timeout_sec != cfg["default_timeout_sec"]:
            meta.append(f"timeout={t.timeout_sec}s")
        meta.append(f"verify: {t.verify_cmd or '-'}")
        print(_ansi("2", "    " + "  ".join(meta)))


def cmd_run(args) -> int:
    root = repo_root()
    tasks_dir = root / TASKS_DIR
    if not tasks_dir.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    if getattr(args, "once", False) and getattr(args, "limit", None) is not None:
        raise Fail("utiliser --once ou --limit, pas les deux")
    limit = 1 if getattr(args, "once", False) else getattr(args, "limit", None)
    if limit is not None and limit < 1:
        raise Fail("--limit doit être >= 1")
    cfg = load_config(root)
    tasks = load_queue(tasks_dir, cfg, args.batch)
    if limit is not None:
        tasks = tasks[:limit]
    if not tasks:
        print("Aucune tâche à exécuter.")
        return 0
    avoid = set(args.avoid_runner or [])
    used = {t.runner for t in tasks} | {t.fallback_runner for t in tasks if t.fallback_runner}
    preference = enabled_runners(cfg)  # ordre de `runners` = préférence pour le repli automatique
    status, args.catalogs = probe_runners(cfg, used | set(preference))
    args.status = status
    args.preference = preference
    args.unavailable = {r for r, why in status.items() if why and r in used}
    for t in tasks:  # repli automatique : premier autre runner réellement utilisable
        if t.fallback_auto:
            t.fallback_runner = next((r for r in preference if r != t.runner and not status[r]), t.fallback_runner)
            if status.get(t.fallback_runner):
                args.unavailable.add(t.fallback_runner)
    for r in sorted(args.unavailable):
        print(f"runner indisponible : {r} ({status[r]})", file=sys.stderr)
    check_models(cfg, tasks, args.catalogs)
    apply_strict_allowed_tools(cfg, tasks)
    validate_queue(root, cfg, tasks)
    check_fallback_map(cfg, tasks, args.catalogs)
    args.usage_cache = UsageCache(cfg, preference, status)
    all_unavailable = args.unavailable | {r for r, why in status.items() if why}
    if cfg.get("permission") != "bypass":
        routed = {
            resolve_task_routing(t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, preference)[0]
            for t in tasks if t.require_commit
        }
        if "agy" in routed:
            print(_ansi("33", 'avertissement : agy avec permission = "accept" bloque les commandes shell '
                        '(git commit) sans règles permissions.allow dans settings.json ; utiliser '
                        'permission = "bypass" si besoin.', sys.stderr), file=sys.stderr)
        if "codex" in routed:
            print(_ansi("33", 'avertissement : codex avec permission = "accept" monte .git/ en lecture seule '
                        '(--sandbox workspace-write), bloquant git commit ; utiliser '
                        'permission = "bypass" si besoin.', sys.stderr), file=sys.stderr)
    if args.dry_run:
        print_dry_run(tasks, cfg, args, status, avoid)
        return 0
    if git("check-ignore", "-q", TASKS_DIR, cwd=root, check=False).returncode != 0:
        raise Fail(".agent-tasks n'est pas ignoré par Git : relancer `agent-runner init`")
    for t in tasks:
        runner, _ = resolve_task_routing(t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, preference)
        if runner in all_unavailable:
            raise Fail(f"{t.id} : runner {runner} indisponible ({status[runner]}) "
                       "et aucun repli disponible (fallback_runner: none, auto_fallback = false "
                       "ou runner de repli lui aussi indisponible)")
    completed: list[Task] = []
    failed: list[Task] = []
    rc: int | None = None
    t0 = time.monotonic()
    usage_file = root / TASKS_DIR / "logs" / "usage.tsv"
    usage_start = len(usage_file.read_text().splitlines()) if usage_file.exists() else 1
    try:
        total = len(tasks)
        for i, task in enumerate(tasks):
            args.last_quota_hit = False
            ok = execute_task(root, cfg, task, args, allow_dirty=args.resume and i == 0,
                              progress=f"[{i + 1}/{total}] ")
            args.usage_cache.on_task_done(quota_hit=args.last_quota_hit)
            if ok:
                completed.append(task)
            else:
                failed.append(task)
                if not args.continue_on_error:
                    rc = 1
                    return rc
        rc = finalize_batches(root, cfg, completed)
        rc = 1 if failed else rc
        return rc
    finally:  # également sur erreur fatale ou Ctrl-C (rc reste None)
        if completed or failed:
            parts = [_ansi("1;32", f"{len(completed)}/{len(tasks)} réussie(s)")]
            if failed:
                parts.append(_ansi("1;31", f"{len(failed)} en échec"))
            parts.append(_ansi("2", _fmt_dur(time.monotonic() - t0)))
            print("\n" + _ansi("1", "Bilan :") + " " + ", ".join(parts))
            if usage_file.exists():
                run_rows = [ln.split("\t") for ln in usage_file.read_text().splitlines()[usage_start:] if ln.strip()]
                if run_rows:
                    _print_savings(summarize_savings([_row_to_attempt(r) for r in run_rows], cfg))
        run_on_finish(root, cfg, rc, tasks, completed, failed)


def run_on_finish(root: Path, cfg: dict, rc: int | None, tasks: list[Task],
                  completed: list[Task], failed: list[Task]) -> None:
    """Lance `on_finish_cmd` (shell, depuis la racine du dépôt) avec le bilan dans l'environnement.

    AGENT_RUNNER_STATUS (success | failure | error), AGENT_RUNNER_EXIT_CODE (vide si interrompu),
    AGENT_RUNNER_TOTAL / _DONE / _FAILED (compteurs), AGENT_RUNNER_DONE_IDS / _FAILED_IDS (ids séparés
    par des espaces), AGENT_RUNNER_BATCH / _BRANCH (valeurs uniques séparées par des espaces),
    AGENT_RUNNER_REPO. Un échec du hook n'affecte pas le code retour du runner.
    """
    cmd = cfg.get("on_finish_cmd") or ""
    if not isinstance(cmd, str):
        print(f"avertissement : config `on_finish_cmd` : chaîne attendue (reçu {cmd!r})", file=sys.stderr)
        return
    if not cmd.strip():
        return
    batches = list(dict.fromkeys(t.batch for t in tasks if t.batch))
    branches = list(dict.fromkeys(t.branch for t in tasks if t.branch))
    env = {
        **os.environ,
        "AGENT_RUNNER_STATUS": "error" if rc is None else "success" if rc == 0 else "failure",
        "AGENT_RUNNER_EXIT_CODE": "" if rc is None else str(rc),
        "AGENT_RUNNER_TOTAL": str(len(tasks)),
        "AGENT_RUNNER_DONE": str(len(completed)),
        "AGENT_RUNNER_FAILED": str(len(failed)),
        "AGENT_RUNNER_DONE_IDS": " ".join(t.id for t in completed),
        "AGENT_RUNNER_FAILED_IDS": " ".join(t.id for t in failed),
        "AGENT_RUNNER_BATCH": " ".join(batches),
        "AGENT_RUNNER_BRANCH": " ".join(branches),
        "AGENT_RUNNER_REPO": str(root),
    }
    try:
        proc = subprocess.run(cmd, shell=True, cwd=root, env=env, stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, errors="replace", timeout=ON_FINISH_TIMEOUT_SEC)
    except subprocess.TimeoutExpired:
        print(f"avertissement : on_finish_cmd interrompu après {ON_FINISH_TIMEOUT_SEC}s", file=sys.stderr)
        return
    except OSError as exc:
        print(f"avertissement : on_finish_cmd : {exc}", file=sys.stderr)
        return
    if proc.returncode != 0:
        print(f"avertissement : on_finish_cmd en échec (code {proc.returncode}) : "
              f"{tail((proc.stderr or proc.stdout).strip(), 500)}", file=sys.stderr)


# -------------------------------------------------------------------------- Init
def detect_stack(root: Path) -> tuple[str, list[str]]:
    verify, tools = "", []
    checks = sorted((root / "tools").glob("check-*.sh")) if (root / "tools").is_dir() else []
    if checks:
        verify = f"tools/{checks[0].name}"
        tools += [f"Bash(tools/{c.name}:*)" for c in checks]
    if (root / "Cargo.toml").exists():
        verify = verify or "cargo test --quiet"
        tools.append("Bash(cargo:*)")
    if (root / "gradlew").exists():
        verify = verify or "./gradlew test"
        tools.append("Bash(./gradlew:*)")
    if (root / "pyproject.toml").exists():
        verify = verify or "python -m pytest -q"
        tools += ["Bash(python:*)", "Bash(pytest:*)"]
    if (root / "package.json").exists():
        verify = verify or "npm test --silent"
        tools += ["Bash(npm:*)", "Bash(npx:*)"]
    return verify, tools


def render_config(main: str, verify: str, tools: list[str], default_runner: str = "claude") -> str:
    j = json.dumps
    allowed = list(DEFAULTS["default_allowed_tools"]) + [t for t in tools if t not in DEFAULTS["default_allowed_tools"]]
    esc = "\n".join(f"{name} = {j(chain)}" for name, chain in DEFAULTS["escalation"].items())
    excl = "\n".join(f"{name} = {j(pats)}" for name, pats in DEFAULTS["exclude_models"].items())
    fmap = "\n\n".join(f"[fallback_map.{dst}]\n" + "\n".join(f"{j(k)} = {j(v)}" for k, v in m.items())
                       for dst, m in DEFAULTS["fallback_map"].items())
    return f"""# Configuration agent-runner (projet). Surcharge ~/.config/agent-task-runner/config.toml.
main_branch = {j(main)}
default_runner = {j(default_runner)}   # choisi par `agent-runner init` parmi les runners installés et connectés
# runners = {j(list(ADAPTERS))}   # runners autorisés (défaut : tous) ; les autres sont traités comme indisponibles
auto_fallback = true   # fiche sans fallback_runner : repli sur l'autre runner (`fallback_runner: none` l'interdit)
default_verify_cmd = {j(verify)}
default_allowed_tools = {j(allowed, ensure_ascii=False)}
default_max_turns = {DEFAULTS["default_max_turns"]}
default_timeout_sec = {DEFAULTS["default_timeout_sec"]}
permission = "accept"   # "accept" (acceptEdits) ou "bypass" (--dangerously-skip-permissions)
strict_allowed_tools = false   # true : pas de repli auto vers un runner qui ignore allowed_tools (agy, codex)
# on_finish_cmd = 'notify-send agent-runner "$AGENT_RUNNER_STATUS : $AGENT_RUNNER_DONE/$AGENT_RUNNER_TOTAL"'
#   lancé en fin de `run` ; variables AGENT_RUNNER_{{STATUS,EXIT_CODE,TOTAL,DONE,FAILED,DONE_IDS,FAILED_IDS,REPO}}

# Chaînes d'escalade, du modèle le moins cher au plus puissant.
# agy : familles sans suffixe d'effort ; le runner compose `<famille>-<effort>` d'après `agy models`
# (`agent-runner models` affiche le catalogue disponible).
[escalation]
{esc}

# Modèles à ne jamais utiliser via un CLI (motifs fnmatch).
[exclude_models]
{excl}

# Équivalences lors d'une bascule vers le runner de repli (table = runner de destination).
{fmap}

# Arguments CLI supplémentaires par runner.
[extra_args]
# claude = []
# agy = []
# codex = []

# Routage dynamique par niveau (fiches avec `level: N1|N2|N3` sans `runner` épinglé) et seuils de quota.
[routing.level_runner]
N1 = "agy"
N2 = "agy"
N3 = "claude"

[routing.quota_threshold]
claude = 80.0
agy = 80.0
codex = 80.0

[routing]
reset_grace_min = 20       # relâche le seuil si le reset est imminent (<= N min) et quota < 95%
usage_refresh_sec = 300    # intervalle minimal (s) entre deux interrogations de quota en cours de run
usage_refresh_tasks = 5    # rafraîchissement paresseux toutes les N tâches
"""


def choose_default_runner(current: str, status: dict[str, str | None]) -> str | None:
    """Garde `current` s'il est utilisable, sinon le premier runner utilisable (ordre de ADAPTERS)."""
    if not status.get(current):
        return current
    return next((r for r in ADAPTERS if not status.get(r)), None)


def set_toml_key(text: str, key: str, value: str) -> str:
    """Fixe une clé de premier niveau d'un TOML en préservant le reste du fichier (commentaires compris)."""
    literal = json.dumps(value)
    pat = re.compile(rf'^({re.escape(key)}\s*=\s*)("[^"]*"|\S+)', re.M)
    # Une clé de premier niveau précède toute table : on ne cherche qu'avant le premier `[table]`.
    first_table = re.search(r"^\s*\[", text, re.M)
    head_end = first_table.start() if first_table else len(text)
    m = pat.search(text, 0, head_end)
    if m:
        return text[: m.start(2)] + literal + text[m.end(2):]
    line = f"{key} = {literal}\n"
    if first_table:
        return text[:head_end] + line + "\n" + text[head_end:]
    return text + ("" if not text or text.endswith("\n") else "\n") + line


def configure_default_runner(root: Path, cfg_path: Path) -> str | None:
    """Vérifie les runners (PATH + connexion) et retourne le default_runner à utiliser (None si aucun)."""
    try:
        cfg = load_config(root)
    except Fail as exc:
        print(f"avertissement : {exc} ; détection des runners avec la configuration par défaut", file=sys.stderr)
        cfg = json.loads(json.dumps(DEFAULTS))
    status, _ = probe_runners(cfg, ADAPTERS)
    for r in ADAPTERS:
        print(f"runner {r} : " + (f"indisponible ({status[r]})" if status[r] else "installé et connecté"))
    current = cfg["default_runner"] if cfg.get("default_runner") in ADAPTERS else "claude"
    chosen = choose_default_runner(current, status)
    if chosen is None:
        print("avertissement : aucun runner utilisable ; default_runner inchangé "
              f"({current}). Installer/connecter {' ou '.join(ADAPTERS)} puis relancer `agent-runner init`.", file=sys.stderr)
        return None
    if not cfg_path.exists():
        return chosen
    text = cfg_path.read_text()
    if chosen != current:
        try:
            tomllib.loads(text)
        except tomllib.TOMLDecodeError:
            print(f"avertissement : {cfg_path} invalide, default_runner non modifié", file=sys.stderr)
            return chosen
        cfg_path.write_text(set_toml_key(text, "default_runner", chosen))
        print(f"default_runner : {current} -> {chosen} ({current} {status[current]})")
    else:
        print(f"default_runner : {chosen} (inchangé)")
    return chosen


def agent_rules_block() -> str:
    return (
        f"{RULES_BEGIN}\n"
        "## agent-task-runner\n\n"
        "- Ne modifie jamais `.agent-tasks/` (file de tâches gérée par `agent-runner`).\n"
        "- Utilise `file-outline <fichier>` pour repérer les plages de lignes exactes avant de lire un fichier entier.\n"
        "- Pour déplacer un gros bloc de lignes (300+) entre fichiers, utilise "
        "`move-lines <src> <début> <fin> <dst>` au lieu de réécrire le code.\n"
        f"{RULES_END}\n"
    )


def inject_rules(path: Path, create: bool) -> bool:
    if not path.exists():
        if not create:
            return False
        path.write_text(agent_rules_block())
        return True
    text = path.read_text()
    block = agent_rules_block()
    pat = re.compile(re.escape(RULES_BEGIN) + r".*?" + re.escape(RULES_END) + r"\n?", re.S)
    new = pat.sub(lambda _m: block, text) if pat.search(text) else text.rstrip("\n") + "\n\n" + block
    if new != text:
        path.write_text(new)
    return True


def update_config_file(cfg_path: Path) -> list[str]:
    """Ajoute les sections `[routing*]` manquantes dans un config.toml existant sans écraser l'existant."""
    text = cfg_path.read_text()
    try:
        parsed = tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise Fail(f"{cfg_path} : TOML invalide : {exc}") from exc
    routing = parsed.get("routing") if isinstance(parsed.get("routing"), dict) else {}
    added: list[str] = []
    chunks: list[str] = []
    if "level_runner" not in routing:
        added.append("routing.level_runner")
        chunks.append(
            "\n# Routage dynamique par niveau (fiches avec `level: N1|N2|N3` sans `runner` épinglé)\n"
            "[routing.level_runner]\nN1 = \"agy\"\nN2 = \"agy\"\nN3 = \"claude\"\n"
        )
    if "quota_threshold" not in routing:
        added.append("routing.quota_threshold")
        chunks.append(
            "\n[routing.quota_threshold]\nclaude = 80.0\nagy = 80.0\ncodex = 80.0\n"
        )
    if not any(k in routing for k in ("reset_grace_min", "usage_refresh_sec", "usage_refresh_tasks")):
        added.append("routing")
        chunks.append(
            "\n[routing]\n"
            "reset_grace_min = 20       # relâche le seuil si le reset est imminent (<= N min) et quota < 95%\n"
            "usage_refresh_sec = 300    # intervalle minimal (s) entre deux interrogations de quota en cours de run\n"
            "usage_refresh_tasks = 5    # rafraîchissement paresseux toutes les N tâches\n"
        )
    if chunks:
        sep = "" if not text or text.endswith("\n") else "\n"
        cfg_path.write_text(text + sep + "".join(chunks))
    return added


def cmd_init(args) -> int:
    root = repo_root()
    base = root / TASKS_DIR
    for d in ("todo", "done", "failed", "logs"):
        (base / d).mkdir(parents=True, exist_ok=True)
    example = base / "todo" / "00-example.md.disabled"
    if not example.exists():
        shutil.copy(TOOL_ROOT / "templates" / "example-task.md", example)

    if args.gitignore:
        target = root / ".gitignore"
    else:
        target = Path(git("rev-parse", "--git-path", "info/exclude", cwd=root).stdout.strip())
        if not target.is_absolute():
            target = root / target
        target.parent.mkdir(parents=True, exist_ok=True)
    existing = target.read_text() if target.exists() else ""
    if not any(ln.strip() in (".agent-tasks/", ".agent-tasks", "/.agent-tasks/", "/.agent-tasks") for ln in existing.splitlines()):
        with target.open("a") as fh:
            fh.write(("" if not existing or existing.endswith("\n") else "\n") + ".agent-tasks/\n")

    cfg_path = base / "config.toml"
    default_runner = configure_default_runner(root, cfg_path)
    if not cfg_path.exists():
        main = next((b for b in ("main", "master") if branch_exists(root, b)), "main")
        verify, tools = detect_stack(root)
        cfg_path.write_text(render_config(main, verify, tools, default_runner or "claude"))
        print(f"config.toml généré (default_runner : {default_runner or 'claude'}, verify par défaut : {verify or '-'})")
    elif args.update_config:
        added = update_config_file(cfg_path)
        if added:
            print(f"config.toml complété ({', '.join(added)})")
        else:
            print("config.toml déjà à jour")
    if args.with_agent_rules:
        inject_rules(root / "CLAUDE.md", create=True)
        inject_rules(root / "AGENTS.md", create=False)
        print("consignes ajoutées à CLAUDE.md (et AGENTS.md s'il existe)")
    print(f"{TASKS_DIR}/ initialisé dans {root}")
    return 0


# ----------------------------------------------------------------- status/retry/clean
def cmd_status(args) -> int:
    root = repo_root()
    base = root / TASKS_DIR
    if not base.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    files = {d: sorted((base / d).glob("*.md")) for d in ("todo", "done", "failed")}
    counts = {d: len(files[d]) for d in files}
    fail_str = _ansi("1;31" if counts["failed"] else "2", f"{counts['failed']} en échec")
    print(f"{'Tâches :':<14} {_ansi('36', str(counts['todo']))} à faire, "
          f"{_ansi('32', str(counts['done']))} terminées, {fail_str}")
    if files["failed"]:
        print(f"{'En échec :':<14} " + ", ".join(p.name for p in files["failed"])
              + _ansi("2", "  (relancer : agent-runner retry <id> ou --all)"))
    usage = base / "logs" / "usage.tsv"
    if not usage.exists():
        print(_ansi("2", "Aucune exécution journalisée."))
        return 0
    rows = [ln.split("\t") for ln in usage.read_text().splitlines()[1:] if ln.strip()]
    per_task: dict[str, int] = {}
    cost = tin = tout = 0.0
    by_model: dict[str, float] = {}
    for r in rows:
        per_task[r[2]] = max(per_task.get(r[2], 0), int(r[3]))
        cost += float(r[11])
        tin += int(r[7]) + int(r[8]) + int(r[9])
        tout += int(r[10])
        by_model[r[5]] = by_model.get(r[5], 0.0) + float(r[11])
    if not rows:
        print(_ansi("2", "Aucune exécution journalisée."))
        return 0
    escalated = sum(1 for n in per_task.values() if n > 1)
    print(f"{'Tentatives :':<14} {len(rows)} sur {len(per_task)} tâches ; escaladées : {escalated} "
          f"({100 * escalated / len(per_task):.0f} %)")
    print(f"{'Tokens :':<14} entrée (cache inclus) {_fmt_int(tin)}, sortie {_fmt_int(tout)}")
    breakdown = ", ".join(f"{m} ${c:.2f}" for m, c in by_model.items())
    print(f"{'Coût cumulé :':<14} {_ansi('1', f'${cost:.2f}')}  " + _ansi("2", f"({breakdown})"))
    return 0


_FILE_PATH_RE = re.compile(r"(?:`([^`\s]+)`|\b([A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+\.[A-Za-z0-9]+|[A-Za-z0-9_.-]+\.(?:py|kt|kts|rs|ts|tsx|js|jsx|go|java|c|cpp|h|tf|tfvars|yml|yaml|json|toml|md|sql|sh))\b)")


def _extract_task_files(body: str) -> set[str]:
    """Extrait les chemins de fichiers mentionnés dans une fiche (en priorité `## Périmètre exact`)."""
    scope_lines: list[str] = []
    in_scope = False
    for line in body.splitlines():
        s = line.strip()
        if s.lower().startswith("## périmètre"):
            in_scope = True
            continue
        if in_scope and s.startswith("## "):
            break
        if in_scope:
            scope_lines.append(line)
    text = "\n".join(scope_lines) if scope_lines else body
    files: set[str] = set()
    for m in _FILE_PATH_RE.finditer(text):
        cand = m.group(1) or m.group(2)
        if cand and ("/" in cand or "." in cand) and not cand.startswith(("http://", "https://")):
            files.add(cand.lstrip("./"))
    return files


def _load_task_files(base: Path) -> dict[str, set[str]]:
    """Associe chaque `task_id` aux fichiers cités dans `.agent-tasks/{done,failed,todo}`."""
    mapping: dict[str, set[str]] = {}
    for folder in ("done", "failed", "todo"):
        d = base / folder
        if not d.is_dir():
            continue
        for p in sorted(d.glob("*.md")):
            try:
                meta, body = parse_frontmatter(p.read_text())
            except ValueError:
                continue
            tid = str(meta.get("id") or p.stem)
            mapping[tid] = _extract_task_files(body)
    return mapping


def _row_to_attempt(r: list[str]) -> dict:
    return {
        "timestamp": r[0], "batch": r[1], "task_id": r[2], "attempt": int(r[3]),
        "runner": r[4], "model": r[5], "turns": int(r[6]),
        "tokens_in": int(r[7]), "cache_write": int(r[8]), "cache_read": int(r[9]), "tokens_out": int(r[10]),
        "cost_usd": round(float(r[11]), 4), "duration_sec": int(float(r[12])), "status": r[13],
    }


def summarize_savings(attempts: list[dict], cfg: dict, task_files: dict[str, set[str]] | None = None) -> dict:
    """Calcule la répartition par palier, la borne basse tout-N3 et le scénario session unique avec cache."""
    by_level = {"N1": 0, "N2": 0, "N3": 0}
    actual_total = 0.0
    billed_total = 0.0
    baseline_total = 0.0
    single_total = 0.0
    seen_files: set[str] = set()
    cum_ctx = 0
    compaction_cap = 150_000  # plafond réaliste avant compaction en session unique
    overlaps: list[float] = []
    for a in attempts:
        runner = a["runner"]
        billed_total += a["cost_usd"]
        files = (task_files or {}).get(a["task_id"], set())
        overlap = (len(files & seen_files) / len(files)) if (files and seen_files) else 0.0
        if files:
            overlaps.append(overlap)
        seen_files |= files
        if runner in ADAPTERS:
            adapter = adapter_for(runner, cfg)
            info = adapter.get_model_info(a["model"]) or {}
            lvl = (info.get("level") or "").rstrip("+")
            if lvl in by_level:
                by_level[lvl] += 1
            p_actual = adapter.get_model_pricing(a["model"])
            actual = a["cost_usd"] if a["cost_usd"] > 0 else (
                adapter.estimate_cost(p_actual, a["tokens_in"], a["cache_write"], a["cache_read"], a["tokens_out"])
                if p_actual else 0.0
            )
            p_base = adapter.get_model_pricing(adapter.baseline_model) if adapter.baseline_model else None
            if p_base:
                baseline = adapter.estimate_cost(p_base, a["tokens_in"], a["cache_write"], a["cache_read"], a["tokens_out"])
                fresh_in = int(a["tokens_in"] * (1.0 - overlap))
                fresh_cw = int(a["cache_write"] * (1.0 - overlap))
                shared_cr = int((a["tokens_in"] + a["cache_write"]) * overlap)
                cum_cr = a["turns"] * cum_ctx
                single = adapter.estimate_cost(p_base, fresh_in, fresh_cw, a["cache_read"] + shared_cr + cum_cr, a["tokens_out"])
                cum_ctx = min(compaction_cap, cum_ctx + fresh_in + fresh_cw + a["tokens_out"])
            else:
                baseline = actual
                single = actual
        else:
            actual = a["cost_usd"]
            baseline = actual
            single = actual
        actual_total += actual
        baseline_total += baseline
        single_total += single
    saved = max(0.0, baseline_total - actual_total)
    saved_pct = round(100.0 * saved / baseline_total, 1) if baseline_total > 0 else 0.0
    avg_overlap_pct = round(100.0 * sum(overlaps) / len(overlaps), 1) if overlaps else 0.0
    return {
        "by_level": by_level,
        "billed_cost_usd": round(billed_total, 4),
        "actual_cost_usd": round(actual_total, 4),
        "baseline_n3_cost_usd": round(baseline_total, 4),
        "single_session_n3_cost_usd": round(single_total, 4),
        "avg_overlap_pct": avg_overlap_pct,
        "saved_usd": round(saved, 4),
        "saved_pct": saved_pct,
    }


def _print_savings(sav: dict) -> None:
    lvl = sav["by_level"]
    dist = ", ".join(f"{lvl[k]} {k}" for k in ("N1", "N2", "N3") if lvl[k])
    if dist:
        print(_ansi("2", f"Paliers : {dist}"))
    if sav["baseline_n3_cost_usd"] > 0 and sav["saved_usd"] > 0:
        billed = sav.get("billed_cost_usd", 0.0)
        billed_note = (f" (dont ${billed:.2f} facturé)"
                       if billed > 0 and abs(sav["actual_cost_usd"] - billed) >= 0.01 else "")
        print(_ansi("2", f"Économie estimée : ${sav['actual_cost_usd']:.2f} réel estimé{billed_note} vs "
                         f"~${sav['baseline_n3_cost_usd']:.2f} en tout-N3 (-{sav['saved_pct']:.0f} %, "
                         "borne basse à tokens identiques ; le gain réel est encore supérieur "
                         "grâce à l'absence de cumul de contexte)"))
    if sav.get("single_session_n3_cost_usd", 0) > 0 and sum(lvl.values()) > 1:
        print(_ansi("2", f"Session unique N3 (modélisée, recouvrement fichiers {sav['avg_overlap_pct']:.0f} %, "
                         f"plafond compaction 150k) : ~${sav['single_session_n3_cost_usd']:.2f}"))


def cmd_report(args) -> int:
    """Affiche le détail des tentatives journalisées dans usage.tsv."""
    root = repo_root()
    base = root / TASKS_DIR
    if not base.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    cfg = load_config(root)
    usage = base / "logs" / "usage.tsv"
    as_json = getattr(args, "json", False)
    rows = [ln.split("\t") for ln in usage.read_text().splitlines()[1:] if ln.strip()] if usage.exists() else []
    if args.batch:
        rows = [r for r in rows if r[1] == args.batch]
    if args.last and args.last > 0:
        rows = rows[-args.last:]
    if not rows:
        if as_json:
            empty_tot = {"count": 0, "turns": 0, "tokens_in": 0, "cache_write": 0,
                         "cache_read": 0, "tokens_out": 0, "cost_usd": 0.0, "duration_sec": 0}
            print(json.dumps({"attempts": [], "total": empty_tot, "savings": summarize_savings([], cfg)},
                             ensure_ascii=False, indent=2))
            return 0
        print(_ansi("2", f"Aucune exécution journalisée" + (f" pour le lot {args.batch!r}." if args.batch else ".")))
        return 0

    parsed = [_row_to_attempt(r) for r in rows]
    tot_in = sum(p["tokens_in"] for p in parsed)
    tot_cw = sum(p["cache_write"] for p in parsed)
    tot_cr = sum(p["cache_read"] for p in parsed)
    tot_out = sum(p["tokens_out"] for p in parsed)
    tot_turns = sum(p["turns"] for p in parsed)
    tot_dur = sum(p["duration_sec"] for p in parsed)
    tot_cost = sum(p["cost_usd"] for p in parsed)
    savings = summarize_savings(parsed, cfg, _load_task_files(base))
    if as_json:
        total = {
            "count": len(parsed), "turns": tot_turns,
            "tokens_in": tot_in, "cache_write": tot_cw, "cache_read": tot_cr, "tokens_out": tot_out,
            "cost_usd": round(tot_cost, 4), "duration_sec": tot_dur,
        }
        print(json.dumps({"attempts": parsed, "total": total, "savings": savings}, ensure_ascii=False, indent=2))
        return 0

    id_w = max(len("Tâche"), *(len(p["task_id"]) for p in parsed))
    mod_w = max(len("Modèle"), *(len(f"{p['runner']} {p['model']}") for p in parsed))
    header = (f"{'Tâche':<{id_w}}  {'#':>2}  {'Modèle':<{mod_w}}  {'Tours':>5}  "
              f"{'Entrée':>9}  {'Cache W':>9}  {'Cache R':>9}  {'Sortie':>9}  {'Coût':>7}  {'Durée':>6}  Statut")
    print(_ansi("1", header))
    print(_ansi("2", "-" * len(header)))
    for p in parsed:
        st = p["status"]
        st_color = "1;32" if st == "success" else "33" if st in ("quota", "max_turns", "timeout") else "1;31"
        model_col = f"{p['runner']} {p['model']}"
        print(f"{p['task_id']:<{id_w}}  {p['attempt']:>2}  {model_col:<{mod_w}}  {p['turns']:>5}  "
              f"{_fmt_int(p['tokens_in']):>9}  {_fmt_int(p['cache_write']):>9}  {_fmt_int(p['cache_read']):>9}  "
              f"{_fmt_int(p['tokens_out']):>9}  ${p['cost_usd']:>6.2f}  {_fmt_dur(p['duration_sec']):>6}  "
              + _ansi(st_color, st))
    print(_ansi("2", "-" * len(header)))
    summary = f"Total ({len(parsed)} tentative(s))"
    print(_ansi("1", f"{summary:<{id_w + 6 + mod_w}}  {tot_turns:>5}  "
                     f"{_fmt_int(tot_in):>9}  {_fmt_int(tot_cw):>9}  {_fmt_int(tot_cr):>9}  "
                     f"{_fmt_int(tot_out):>9}  ${tot_cost:>6.2f}  {_fmt_dur(tot_dur):>6}"))
    _print_savings(savings)
    return 0


def cmd_logs(args) -> int:
    """Affiche ou suit en temps réel les journaux d'exécution formatés pour un humain."""
    logs_dir: Path | None = None
    batch_ids: set[str] | None = None
    follow_new = True
    target = args.target

    if args.file:
        path = Path(args.file)
        if not path.is_file():
            raise Fail(f"fichier de log introuvable : {args.file}")
        files = [path]
        follow_new = False
    else:
        root = repo_root()
        base = root / TASKS_DIR
        if not base.is_dir():
            raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
        logs_dir = base / "logs"
        if target and Path(target).is_file():
            files = [Path(target)]
            follow_new = False
        else:
            if args.batch:
                batch_ids = collect_batch_task_ids(base, args.batch, parse_frontmatter)
                if not batch_ids:
                    raise Fail(f"aucune tâche trouvée pour le lot {args.batch!r}")
            files = find_matching_logs(logs_dir, target=target, batch_ids=batch_ids)
            if not args.batch and not target and len(files) > 1:
                files = [files[-1]]
            if not files and not args.stream:
                scope = f" pour le lot {args.batch!r}" if args.batch else (f" pour {target!r}" if target else "")
                print(_ansi("2", f"Aucun journal trouvé{scope}."))
                return 0

    use_pager = bool(not args.stream and not args.no_pager and sys.stdout.isatty())
    use_color = bool(not args.no_color and not os.environ.get("NO_COLOR") and (use_pager or sys.stdout.isatty()))
    style = Style(use_color)

    if args.stream:
        if not files:
            print(style.dim("En attente du prochain fichier de log..."), flush=True)
        try:
            stream_logs(
                files,
                logs_dir,
                target=target,
                batch_ids=batch_ids,
                follow_new=follow_new,
                style=style,
                raw=args.raw,
                include_verify=args.verify,
            )
        except KeyboardInterrupt:
            print()
            return 0
    else:
        render_logs_cold(
            files,
            style,
            raw=args.raw,
            include_verify=args.verify,
            use_pager=use_pager,
        )
    return 0


def cmd_retry(args) -> int:
    root = repo_root()
    base = root / TASKS_DIR
    if args.all == bool(args.id):
        raise Fail("retry : indiquer un id ou --all (pas les deux)")
    moved = 0
    for p in sorted((base / "failed").glob("*.md")):
        if not args.all:
            try:
                meta, _ = parse_frontmatter(p.read_text())
            except ValueError:
                meta = {}
            if args.id not in (str(meta.get("id")), p.stem):
                continue
        dest = base / "todo" / p.name
        if dest.exists():
            print(f"{p.name} : déjà présente dans todo/, laissée dans failed/", file=sys.stderr)
            if not args.all:
                return 1
            continue
        text = p.read_text()
        if FAILURE_MARKER in text:
            text = text[: text.index(FAILURE_MARKER)].rstrip("\n") + "\n"
        dest.write_text(text)
        p.unlink()
        print(f"{p.name} remise dans todo/")
        moved += 1
        if not args.all:
            return 0
    if args.all:
        print(f"{moved} tâche(s) remise(s) dans todo/" if moved else "Aucune tâche dans failed/.")
        return 0
    raise Fail(f"tâche {args.id!r} introuvable dans failed/")


def _pending_for_batch(tasks_dir: Path, batch: str) -> list[str]:
    remaining = []
    for folder in ("todo", "failed"):
        for p in sorted((tasks_dir / folder).glob("*.md")):
            try:
                meta, _ = parse_frontmatter(p.read_text())
            except ValueError:
                continue
            if meta.get("batch", "default") == batch:
                remaining.append(f"{folder}/{p.name}")
    return remaining


def cmd_merge(args) -> int:
    """Fusionne un ou tous les lots terminés (done/) dans leur base_branch avec message structuré."""
    root = repo_root()
    base = root / TASKS_DIR
    if not base.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    if args.batch and args.all:
        raise Fail("utiliser --batch ou --all, pas les deux")
    cfg = load_config(root)
    done_tasks = [parse_task(p, cfg) for p in sorted((base / "done").glob("*.md"))]
    if not done_tasks:
        print("Aucune tâche terminée dans done/.")
        return 0
    by_batch: dict[str, list[Task]] = {}
    for t in done_tasks:
        by_batch.setdefault(t.batch, []).append(t)

    if args.all:
        targets: list[str] = []
        for b, b_tasks in by_batch.items():
            last = b_tasks[-1]
            rem = _pending_for_batch(base, b) if not args.force else []
            if rem:
                print(f"lot {b} : ignoré (tâches restantes : {', '.join(rem)})")
                continue
            if last.branch == last.base_branch or not branch_exists(root, last.branch):
                print(f"lot {b} : ignoré (branche {last.branch!r} déjà fusionnée ou absente)")
                continue
            targets.append(b)
        if not targets:
            print("Aucun chantier terminé à fusionner.")
            return 0
    else:
        batch = args.batch
        if not batch:
            if len(by_batch) > 1:
                raise Fail(f"plusieurs lots dans done/ ({', '.join(sorted(by_batch))}) : préciser --batch <nom> ou --all")
            batch = next(iter(by_batch))
        elif batch not in by_batch:
            raise Fail(f"lot {batch!r} introuvable dans done/ (disponibles : {', '.join(sorted(by_batch))})")
        targets = [batch]

    rc = 0
    for batch in targets:
        batch_tasks = by_batch[batch]
        last = batch_tasks[-1]
        msg = build_merge_message(root, batch, batch_tasks, last.branch, last.base_branch) if args.strategy != "ff" else None
        if args.dry_run:
            print(_ansi("1", f"Merge prévu pour le lot {batch!r} ({len(batch_tasks)} tâche(s)) :"))
            print(f"  {last.branch} -> {last.base_branch} (stratégie : {args.strategy}, "
                  f"suppression branche : {'non' if args.no_delete else 'oui'})")
            if msg:
                print(_ansi("2", "\nMessage de commit :\n" + "\n".join(f"  {ln}" for ln in msg.splitlines())))
            if len(targets) > 1:
                print()
            continue
        if merge_batch_branch(
            root, base, batch, last.branch, last.base_branch, args.strategy,
            message=msg, delete_branch=not args.no_delete, force=args.force,
        ) != 0:
            rc = 1
    if rc != 0:
        raise Fail("échec du merge d'au moins un lot")
    return 0


def cmd_create_plan(args) -> int:
    """Découpe un ou plusieurs documents (plan, spécification, cartographie) en fiches `.agent-tasks/todo/`."""
    root = repo_root()
    base = root / TASKS_DIR
    if not base.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    if dirty(root):
        raise Fail("arbre de travail non propre (fichiers suivis modifiés) : commit ou stash avant `create-plan`")
    plan_paths: list[Path] = []
    for raw in args.plans:
        p = Path(raw)
        if not p.is_absolute():
            p = (Path.cwd() / p).resolve()
        if not p.is_file():
            raise Fail(f"document introuvable : {raw}")
        plan_paths.append(p)

    cfg = load_config(root)
    preference = enabled_runners(cfg)
    statuses, catalogs = probe_runners(cfg, set(preference) | ({args.runner} if args.runner else set()))
    runner = args.runner or cfg["default_runner"]
    if statuses.get(runner):
        avail = [r for r in preference if not statuses.get(r)]
        if args.runner or not avail:
            raise Fail(f"runner {runner!r} indisponible : {statuses.get(runner) or 'aucun runner disponible'}")
        runner = avail[0]

    adapter = adapter_for(runner, cfg)
    model_name = args.model or level_models("N2", runner, cfg)[0] or cfg["escalation"][runner][0]
    effort = args.effort or "medium"
    model_id = adapter.resolve_model(model_name, effort, catalogs.get(runner))

    skill_file = TOOL_ROOT / "skills" / "plan-tasks" / "SKILL.md"
    skill_text = skill_file.read_text() if skill_file.is_file() else ""
    constraints = []
    if args.batch:
        constraints.append(f"- `batch`: `{args.batch}`")
    if args.branch:
        constraints.append(f"- `branch`: `{args.branch}`")
    if args.base_branch:
        constraints.append(f"- `base_branch`: `{args.base_branch}`")
    q_begin, q_end = "<!-- agent-runner:questions -->", "<!-- /agent-runner:questions -->"
    docs_list = ", ".join(f"`{p}`" for p in plan_paths)
    docs_sections = "\n\n".join(f"## Document : {p.name} ({p})\n\n{p.read_text()}" for p in plan_paths)
    prompt = (
        f"Planifie les documents suivants ({docs_list}) en micro-tâches dans `.agent-tasks/todo/` en suivant "
        f"strictement le skill `plan-tasks` ci-dessous.\n\n"
        + ("Contraintes imposées :\n" + "\n".join(constraints) + "\n\n" if constraints else "")
        + "## Protocole en cas d'ambiguïté (OBLIGATOIRE)\n"
        "Si ces documents comportent des ambiguïtés bloquantes ou des choix d'architecture non tranchés "
        "qui t'empêchent de rédiger des fiches autonomes et sûres :\n"
        "- NE CRÉE AUCUNE fiche dans `.agent-tasks/todo/` et ne modifie aucun fichier.\n"
        f"- Réponds uniquement avec un bloc balisé `{q_begin} ... {q_end}` listant "
        "chaque question numérotée suivie de `- Recommandation : ...`.\n\n"
        f"## Instructions plan-tasks\n\n{skill_text}\n\n"
        f"{docs_sections}"
    )

    head_before = git("rev-parse", "HEAD", cwd=root).stdout.strip()
    todo_dir = base / "todo"
    todo_before = set(todo_dir.glob("*.md"))
    logs = base / "logs"
    logs.mkdir(exist_ok=True)
    req = RunRequest(
        prompt=prompt, model=model_id, cwd=root,
        allowed_tools=list(cfg["default_allowed_tools"]) + ["Read", "Write", "Glob", "Grep"],
        max_turns=30, timeout_sec=cfg["default_timeout_sec"], max_budget_usd=None,
        permission_mode=cfg["permission"], effort=effort,
        extra_args=list(cfg.get("extra_args", {}).get(runner, [])),
    )
    label = ", ".join(p.name for p in plan_paths)
    print(_ansi("1", f"create-plan : {label} ({runner}/{model_id}, effort={effort})"))
    res = adapter.run(req, logs / "create-plan.log", logs / "create-plan.json")

    # Garde-fou code source : rollback Git si un fichier suivi/non-suivi hors .agent-tasks/ a été modifié.
    if dirty(root) or git("rev-parse", "HEAD", cwd=root).stdout.strip() != head_before:
        git("reset", "--hard", head_before, cwd=root)
        git("clean", "-fd", "-e", TASKS_DIR, cwd=root)

    def _rollback_todo() -> None:
        for p in set(todo_dir.glob("*.md")) - todo_before:
            p.unlink()

    q_match = re.search(rf"{re.escape(q_begin)}(.*?){re.escape(q_end)}", res.result_text, re.S)
    if q_match:
        _rollback_todo()
        questions = q_match.group(1).strip()
        print(_ansi("1;33", "\ncreate-plan interrompu : l'agent a des questions avant de découper le plan.\n"))
        print(questions)
        opts = " ".join(f"--{k} {v}" for k, v in (("batch", args.batch), ("branch", args.branch), ("base-branch", args.base_branch)) if v)
        print(_ansi("1", "\nPrompt à exécuter en session interactive (Claude / agy) :\n"))
        print(f"Utilise le skill plan-tasks pour découper {' '.join(str(p) for p in plan_paths)} dans .agent-tasks/todo/ "
              + (f"({opts}) " if opts else "")
              + "en tenant compte des réponses suivantes :\n"
              + "\n".join(ln for ln in questions.splitlines() if ln.strip()))
        return 2

    if res.error:
        _rollback_todo()
        raise Fail(f"create-plan : {res.error}")

    new_files = sorted(set(todo_dir.glob("*.md")) - todo_before)
    if not new_files:
        raise Fail("create-plan : aucune fiche créée dans `.agent-tasks/todo/`.")

    tasks = [parse_task(p, cfg) for p in new_files]
    print(_ansi("1;32", f"\n{len(tasks)} fiche(s) créée(s) et validée(s) dans .agent-tasks/todo/ :"))
    for t in tasks:
        print(f"  - {t.path.name}  [level={t.level or '-'} branch={t.branch}]")
    print(_ansi("2", "\nVérifie avec : agent-runner run --dry-run"))
    return 0


def cmd_clean(args) -> int:
    root = repo_root()
    base = root / TASKS_DIR
    targets = ["logs"] + (["done"] if args.all else [])
    for d in targets:
        shutil.rmtree(base / d, ignore_errors=True)
        (base / d).mkdir(exist_ok=True)
    print("supprimé : " + ", ".join(f"{d}/" for d in targets))
    return 0


# --------------------------------------------------------------------------- CLI
def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="agent-runner", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init", help="initialise .agent-tasks/ dans le dépôt courant")
    p.add_argument("--gitignore", action="store_true", help="utilise .gitignore au lieu de .git/info/exclude")
    p.add_argument("--with-agent-rules", action="store_true", help="ajoute les consignes à CLAUDE.md / AGENTS.md")
    p.add_argument("--update-config", action="store_true", help="complète un config.toml existant avec les nouvelles sections")
    p.set_defaults(func=cmd_init)
    p = sub.add_parser("run", help="exécute les tâches de .agent-tasks/todo/")
    p.add_argument("--batch", help="ne traite que ce lot")
    p.add_argument("--dry-run", action="store_true", help="affiche le plan sans exécuter")
    p.add_argument("--resume", action="store_true", help="reprend en conservant les modifications partielles")
    p.add_argument("--continue-on-error", action="store_true", help="rollback vers failed/ et continue")
    p.add_argument("--model", help="force le modèle de départ")
    p.add_argument("--no-escalate", action="store_true", help="désactive l'escalade de modèle")
    p.add_argument("--avoid-runner", action="append", choices=sorted(ADAPTERS), metavar="RUNNER",
                   help="bascule d'emblée sur leur runner de repli les tâches de ce runner (ex. quota presque plein) ; "
                        "répétable")
    p.add_argument("--once", action="store_true", help="n'exécute que la prochaine tâche (équivalent à --limit 1)")
    p.add_argument("--limit", type=int, help="exécute au plus N tâches")
    p.set_defaults(func=cmd_run)
    p = sub.add_parser("models", help="chaînes configurées et modèles disponibles (agy models)")
    p.add_argument("runner", nargs="?", choices=sorted(ADAPTERS))
    p.set_defaults(func=cmd_models)
    p = sub.add_parser("status", help="avancement, taux d'escalade et coûts")
    p.set_defaults(func=cmd_status)
    p = sub.add_parser("report", help="détail par tentative (tokens, coût, durée, statut)")
    p.add_argument("--batch", help="filtre sur un lot")
    p.add_argument("--last", type=int, help="affiche les N dernières tentatives")
    p.add_argument("--json", action="store_true", help="sortie structurée au format JSON")
    p.set_defaults(func=cmd_report)
    p = sub.add_parser("logs", help="affiche ou suit les journaux d'exécution formatés pour un humain")
    p.add_argument("target", nargs="?", help="identifiant de tâche (ou chemin de fichier)")
    p.add_argument("--file", dest="file", help="chemin vers un fichier de log spécifique")
    p.add_argument("--batch", help="affiche/suit les logs de toutes les tâches du lot")
    p.add_argument("-f", "--stream", action="store_true", help="suit les logs en temps réel")
    p.add_argument("--verify", action="store_true", help="inclut les fichiers .verify.log associés")
    p.add_argument("--raw", action="store_true", help="affiche les lignes brutes sans formatage")
    p.add_argument("--no-pager", action="store_true", help="désactive le pager (less -R)")
    p.add_argument("--no-color", action="store_true", help="désactive la coloration ANSI")
    p.set_defaults(func=cmd_logs)
    p = sub.add_parser("retry", help="remet une tâche (ou toutes avec --all) de failed/ dans todo/")
    p.add_argument("id", nargs="?")
    p.add_argument("--all", action="store_true", help="remet toutes les tâches de failed/ dans todo/")
    p.set_defaults(func=cmd_retry)
    p = sub.add_parser("merge", help="fusionne un lot terminé (done/) dans sa base_branch")
    p.add_argument("--batch", help="lot à fusionner (obligatoire si plusieurs lots dans done/ sans --all)")
    p.add_argument("--all", action="store_true", help="fusionne tous les lots terminés dont la branche existe encore")
    p.add_argument("--strategy", choices=("no-ff", "ff", "squash"), default="no-ff",
                   help="stratégie de fusion (défaut : no-ff)")
    p.add_argument("--no-delete", action="store_true", help="conserve la branche après fusion")
    p.add_argument("--force", action="store_true", help="autorise la fusion même s'il reste des tâches dans todo/failed")
    p.add_argument("--dry-run", action="store_true", help="affiche le merge et le message sans exécuter")
    p.set_defaults(func=cmd_merge)
    p = sub.add_parser("clean", help="supprime logs/ (et done/ avec --all)")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_clean)
    p = sub.add_parser("create-plan", help="découpe un ou plusieurs documents (plan, spec, carto) en fiches todo/")
    p.add_argument("plans", nargs="+", help="chemin(s) vers le(s) fichier(s) plan / spec / cartographie")
    p.add_argument("--batch", help="nom du lot imposé aux fiches")
    p.add_argument("--branch", help="branche cible imposée aux fiches")
    p.add_argument("--base-branch", help="branche de base (défaut : main)")
    p.add_argument("--runner", choices=sorted(ADAPTERS), help="force un runner")
    p.add_argument("--model", help="force un modèle")
    p.add_argument("--effort", choices=EFFORTS, help="effort de raisonnement")
    p.set_defaults(func=cmd_create_plan)
    return ap


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except Fail as exc:
        print(_ansi("1;31", "agent-runner:", sys.stderr) + f" {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nagent-runner: interrompu ; relancer avec --resume pour reprendre le travail partiel.",
              file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
