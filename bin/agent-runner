    "on_finish_cmd": "",
    "escalation": {adapter: list(cls.default_chain) for adapter, cls in ADAPTERS.items()},
    # Modèles qu'un CLI ne doit jamais utiliser (motifs fnmatch) : Claude via agy a un quota très réduit.
    "exclude_models": {"agy": ["claude-*"]},
