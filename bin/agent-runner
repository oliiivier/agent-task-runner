def print_dry_run(tasks: list[Task], cfg: dict, args, status: dict[str, str | None], avoid: set[str]) -> None:
    """Affiche le plan d'exécution (--dry-run) regroupé par lot/branche, avec alignement et couleurs TTY."""
    print(_ansi("1", f"Plan d'exécution : {len(tasks)} tâche(s)"))
    name_w = min(max(len(t.path.name) for t in tasks), 36)
    last_group: tuple[str, str, str, str] | None = None
    all_unavailable = args.unavailable | {r for r, why in status.items() if why}
    for t in tasks:
        runner, routing_reason = resolve_task_routing(
            t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, args.preference
        )
        adapter = adapter_for(runner, cfg)
        effective_effort = t.effort or (level_models(t.level, runner, cfg)[2] if t.level else None)
        try:
            chain = [adapter.resolve_model(m, effective_effort, args.catalogs.get(runner))
                     for m in candidate_models(t, cfg, args.model, args.no_escalate, runner,
                                               windows=args.usage_cache.snapshot.get(runner))]
        except ValueError as exc:
            raise Fail(f"{t.id} : {exc}") from exc
        group = (t.batch, t.branch, t.base_branch, t.merge_strategy)
        if group != last_group:
            last_group = group
            print()
            print(_ansi("1;36", f"[{t.batch}]") + f"  branche {_ansi('1', t.branch)} <- {t.base_branch}  "
                  + _ansi("2", f"(merge: {t.merge_strategy})"))
        notes: list[str] = []
        if t.fallback_runner and t.fallback_runner != runner:
            notes.append(_ansi("2", f"(repli {'auto ' if t.fallback_auto else ''}{t.fallback_runner})"))
        elif runner != t.runner:
            notes.append(_ansi("2", f"(au lieu de {t.runner}{', repli auto' if t.fallback_auto else ''})"))
        notes.append(_ansi("2", f"[{routing_reason}]"))
        if runner in args.unavailable:
            notes.append(_ansi("1;31", f"[INDISPONIBLE : {status[runner]}]"))
        if t.allowed_tools:
            if not adapter.supports_allowed_tools:
                notes.append(_ansi("33", "[sans restriction d'outils]"))
            elif t.fallback_runner and not adapter_for(t.fallback_runner, cfg).supports_allowed_tools:
                notes.append(_ansi("33", f"[repli {t.fallback_runner} : sans restriction d'outils]"))
        suffix = ("  " + " ".join(notes)) if notes else ""
        print(f"  {t.path.name:<{name_w}}  {_ansi('32', f'{runner:<6}')}  {' -> '.join(chain)}{suffix}")
        meta = []
        if t.level:
            meta.append(f"level={t.level}")
        if effective_effort:
            meta.append(f"effort={effective_effort}")
        meta.append(f"max_turns={t.max_turns}")
        if t.timeout_sec != cfg["default_timeout_sec"]:
            meta.append(f"timeout={t.timeout_sec}s")
        meta.append(f"verify: {t.verify_cmd or '-'}")
        print(_ansi("2", "    " + "  ".join(meta)))


def cmd_run(args) -> int:
    root = repo_root()
    tasks_dir = root / TASKS_DIR
    if not tasks_dir.is_dir():
        raise Fail("`.agent-tasks/` introuvable : lancer `agent-runner init`")
    if getattr(args, "once", False) and getattr(args, "limit", None) is not None:
        raise Fail("utiliser --once ou --limit, pas les deux")
    limit = 1 if getattr(args, "once", False) else getattr(args, "limit", None)
    if limit is not None and limit < 1:
        raise Fail("--limit doit être >= 1")
    cfg = load_config(root)
    tasks = load_queue(tasks_dir, cfg, args.batch)
    if limit is not None:
        tasks = tasks[:limit]
    if not tasks:
        print("Aucune tâche à exécuter.")
        return 0
    avoid = set(args.avoid_runner or [])
    used = {t.runner for t in tasks} | {t.fallback_runner for t in tasks if t.fallback_runner}
    preference = enabled_runners(cfg)  # ordre de `runners` = préférence pour le repli automatique
    status, args.catalogs = probe_runners(cfg, used | set(preference))
    args.status = status
    args.preference = preference
    args.unavailable = {r for r, why in status.items() if why and r in used}
    for t in tasks:  # repli automatique : premier autre runner réellement utilisable
        if t.fallback_auto:
            t.fallback_runner = next((r for r in preference if r != t.runner and not status[r]), t.fallback_runner)
            if status.get(t.fallback_runner):
                args.unavailable.add(t.fallback_runner)
    for r in sorted(args.unavailable):
        print(f"runner indisponible : {r} ({status[r]})", file=sys.stderr)
    check_models(cfg, tasks, args.catalogs)
    apply_strict_allowed_tools(cfg, tasks)
    validate_queue(root, cfg, tasks)
    check_fallback_map(cfg, tasks, args.catalogs)
    args.usage_cache = UsageCache(cfg, preference, status)
    all_unavailable = args.unavailable | {r for r, why in status.items() if why}
    if cfg.get("permission") != "bypass":
        routed = {
            resolve_task_routing(t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, preference)[0]
            for t in tasks if t.require_commit
        }
        if "agy" in routed:
            print(_ansi("33", 'avertissement : agy avec permission = "accept" bloque les commandes shell '
                        '(git commit) sans règles permissions.allow dans settings.json ; utiliser '
                        'permission = "bypass" si besoin.', sys.stderr), file=sys.stderr)
        if "codex" in routed:
            print(_ansi("33", 'avertissement : codex avec permission = "accept" monte .git/ en lecture seule '
                        '(--sandbox workspace-write), bloquant git commit ; utiliser '
                        'permission = "bypass" si besoin.', sys.stderr), file=sys.stderr)
    if args.dry_run:
        print_dry_run(tasks, cfg, args, status, avoid)
        return 0
    if git("check-ignore", "-q", TASKS_DIR, cwd=root, check=False).returncode != 0:
        raise Fail(".agent-tasks n'est pas ignoré par Git : relancer `agent-runner init`")
    for t in tasks:
        runner, _ = resolve_task_routing(t, cfg, all_unavailable, args.usage_cache.snapshot, avoid, preference)
        if runner in all_unavailable:
            raise Fail(f"{t.id} : runner {runner} indisponible ({status[runner]}) "
                       "et aucun repli disponible (fallback_runner: none, auto_fallback = false "
                       "ou runner de repli lui aussi indisponible)")
    completed: list[Task] = []
    failed: list[Task] = []
    rc: int | None = None
    t0 = time.monotonic()
    usage_file = root / TASKS_DIR / "logs" / "usage.tsv"
    usage_start = len(usage_file.read_text().splitlines()) if usage_file.exists() else 1
    try:
        total = len(tasks)
        for i, task in enumerate(tasks):
            args.last_quota_hit = False
            ok = execute_task(root, cfg, task, args, allow_dirty=args.resume and i == 0,
                              progress=f"[{i + 1}/{total}] ")
            args.usage_cache.on_task_done(quota_hit=args.last_quota_hit)
            if ok:
                completed.append(task)
            else:
                failed.append(task)
                if not args.continue_on_error:
                    rc = 1
                    return rc
        rc = finalize_batches(root, cfg, completed)
        rc = 1 if failed else rc
        return rc
    finally:  # également sur erreur fatale ou Ctrl-C (rc reste None)
        if completed or failed:
            parts = [_ansi("1;32", f"{len(completed)}/{len(tasks)} réussie(s)")]
            if failed:
                parts.append(_ansi("1;31", f"{len(failed)} en échec"))
            parts.append(_ansi("2", _fmt_dur(time.monotonic() - t0)))
            print("\n" + _ansi("1", "Bilan :") + " " + ", ".join(parts))
            if usage_file.exists():
                run_rows = [ln.split("\t") for ln in usage_file.read_text().splitlines()[usage_start:] if ln.strip()]
                if run_rows:
                    _print_savings(summarize_savings([_row_to_attempt(r) for r in run_rows], cfg))
        run_on_finish(root, cfg, rc, tasks, completed, failed)


def run_on_finish(root: Path, cfg: dict, rc: int | None, tasks: list[Task],
                  completed: list[Task], failed: list[Task]) -> None:
    """Lance `on_finish_cmd` (shell, depuis la racine du dépôt) avec le bilan dans l'environnement.

    AGENT_RUNNER_STATUS (success | failure | error), AGENT_RUNNER_EXIT_CODE (vide si interrompu),
    AGENT_RUNNER_TOTAL / _DONE / _FAILED (compteurs), AGENT_RUNNER_DONE_IDS / _FAILED_IDS (ids séparés
    par des espaces), AGENT_RUNNER_BATCH / _BRANCH (valeurs uniques séparées par des espaces),
    AGENT_RUNNER_REPO. Un échec du hook n'affecte pas le code retour du runner.
    """
    cmd = cfg.get("on_finish_cmd") or ""
    if not isinstance(cmd, str):
        print(f"avertissement : config `on_finish_cmd` : chaîne attendue (reçu {cmd!r})", file=sys.stderr)
        return
    if not cmd.strip():
        return
    batches = list(dict.fromkeys(t.batch for t in tasks if t.batch))
    branches = list(dict.fromkeys(t.branch for t in tasks if t.branch))
    env = {
        **os.environ,
        "AGENT_RUNNER_STATUS": "error" if rc is None else "success" if rc == 0 else "failure",
        "AGENT_RUNNER_EXIT_CODE": "" if rc is None else str(rc),
        "AGENT_RUNNER_TOTAL": str(len(tasks)),
        "AGENT_RUNNER_DONE": str(len(completed)),
        "AGENT_RUNNER_FAILED": str(len(failed)),
        "AGENT_RUNNER_DONE_IDS": " ".join(t.id for t in completed),
        "AGENT_RUNNER_FAILED_IDS": " ".join(t.id for t in failed),
        "AGENT_RUNNER_BATCH": " ".join(batches),
        "AGENT_RUNNER_BRANCH": " ".join(branches),
        "AGENT_RUNNER_REPO": str(root),
    }
    try:
        proc = subprocess.run(cmd, shell=True, cwd=root, env=env, stdin=subprocess.DEVNULL,
                              capture_output=True, text=True, errors="replace", timeout=ON_FINISH_TIMEOUT_SEC)
    except subprocess.TimeoutExpired:
        print(f"avertissement : on_finish_cmd interrompu après {ON_FINISH_TIMEOUT_SEC}s", file=sys.stderr)
        return
    except OSError as exc:
        print(f"avertissement : on_finish_cmd : {exc}", file=sys.stderr)
        return
    if proc.returncode != 0:
        print(f"avertissement : on_finish_cmd en échec (code {proc.returncode}) : "
              f"{tail((proc.stderr or proc.stdout).strip(), 500)}", file=sys.stderr)


# -------------------------------------------------------------------------- Init
def detect_stack(root: Path) -> tuple[str, list[str]]:
    verify, tools = "", []
    checks = sorted((root / "tools").glob("check-*.sh")) if (root / "tools").is_dir() else []
    if checks:
        verify = f"tools/{checks[0].name}"
        tools += [f"Bash(tools/{c.name}:*)" for c in checks]
    if (root / "Cargo.toml").exists():
        verify = verify or "cargo test --quiet"
        tools.append("Bash(cargo:*)")
    if (root / "gradlew").exists():
        verify = verify or "./gradlew test"
        tools.append("Bash(./gradlew:*)")
    if (root / "pyproject.toml").exists():
        verify = verify or "python -m pytest -q"
        tools += ["Bash(python:*)", "Bash(pytest:*)"]
    if (root / "package.json").exists():
        verify = verify or "npm test --silent"
        tools += ["Bash(npm:*)", "Bash(npx:*)"]
    return verify, tools


def render_config(main: str, verify: str, tools: list[str], default_runner: str = "claude") -> str:
    j = json.dumps
    allowed = list(DEFAULTS["default_allowed_tools"]) + [t for t in tools if t not in DEFAULTS["default_allowed_tools"]]
    esc = "\n".join(f"{name} = {j(chain)}" for name, chain in DEFAULTS["escalation"].items())
    excl = "\n".join(f"{name} = {j(pats)}" for name, pats in DEFAULTS["exclude_models"].items())
    fmap = "\n\n".join(f"[fallback_map.{dst}]\n" + "\n".join(f"{j(k)} = {j(v)}" for k, v in m.items())
                       for dst, m in DEFAULTS["fallback_map"].items())
    return f"""# Configuration agent-runner (projet). Surcharge ~/.config/agent-task-runner/config.toml.
main_branch = {j(main)}
default_runner = {j(default_runner)}   # choisi par `agent-runner init` parmi les runners installés et connectés
# runners = {j(list(ADAPTERS))}   # runners autorisés (défaut : tous) ; les autres sont traités comme indisponibles
auto_fallback = true   # fiche sans fallback_runner : repli sur l'autre runner (`fallback_runner: none` l'interdit)
default_verify_cmd = {j(verify)}
default_allowed_tools = {j(allowed, ensure_ascii=False)}
default_max_turns = {DEFAULTS["default_max_turns"]}
default_timeout_sec = {DEFAULTS["default_timeout_sec"]}
permission = "accept"   # "accept" (acceptEdits) ou "bypass" (--dangerously-skip-permissions)
strict_allowed_tools = false   # true : pas de repli auto vers un runner qui ignore allowed_tools (agy, codex)
# on_finish_cmd = 'notify-send agent-runner "$AGENT_RUNNER_STATUS : $AGENT_RUNNER_DONE/$AGENT_RUNNER_TOTAL"'
#   lancé en fin de `run` ; variables AGENT_RUNNER_{{STATUS,EXIT_CODE,TOTAL,DONE,FAILED,DONE_IDS,FAILED_IDS,REPO}}

# Chaînes d'escalade, du modèle le moins cher au plus puissant.
# agy : familles sans suffixe d'effort ; le runner compose `<famille>-<effort>` d'après `agy models`
# (`agent-runner models` affiche le catalogue disponible).
[escalation]
{esc}

# Modèles à ne jamais utiliser via un CLI (motifs fnmatch).
[exclude_models]
{excl}

# Équivalences lors d'une bascule vers le runner de repli (table = runner de destination).
{fmap}

# Arguments CLI supplémentaires par runner.
[extra_args]
# claude = []
# agy = []
# codex = []

# Routage dynamique par niveau (fiches avec `level: N1|N2|N3` sans `runner` épinglé) et seuils de quota.
[routing.level_runner]
N1 = "agy"
N2 = "agy"
N3 = "claude"

[routing.quota_threshold]
claude = 80.0
agy = 80.0
codex = 80.0

[routing]
reset_grace_min = 20       # relâche le seuil si le reset est imminent (<= N min) et quota < 95%
usage_refresh_sec = 300    # intervalle minimal (s) entre deux interrogations de quota en cours de run
usage_refresh_tasks = 5    # rafraîchissement paresseux toutes les N tâches
"""


def choose_default_runner(current: str, status: dict[str, str | None]) -> str | None:
    """Garde `current` s'il est utilisable, sinon le premier runner utilisable (ordre de ADAPTERS)."""
    if not status.get(current):
        return current
    return next((r for r in ADAPTERS if not status.get(r)), None)


def set_toml_key(text: str, key: str, value: str) -> str:
    """Fixe une clé de premier niveau d'un TOML en préservant le reste du fichier (commentaires compris)."""
    literal = json.dumps(value)
    pat = re.compile(rf'^({re.escape(key)}\s*=\s*)("[^"]*"|\S+)', re.M)
    # Une clé de premier niveau précède toute table : on ne cherche qu'avant le premier `[table]`.
    first_table = re.search(r"^\s*\[", text, re.M)
    head_end = first_table.start() if first_table else len(text)
    m = pat.search(text, 0, head_end)
    if m:
        return text[: m.start(2)] + literal + text[m.end(2):]
    line = f"{key} = {literal}\n"
    if first_table:
        return text[:head_end] + line + "\n" + text[head_end:]
    return text + ("" if not text or text.endswith("\n") else "\n") + line


def configure_default_runner(root: Path, cfg_path: Path) -> str | None:
    """Vérifie les runners (PATH + connexion) et retourne le default_runner à utiliser (None si aucun)."""
    try:
        cfg = load_config(root)
    except Fail as exc:
        print(f"avertissement : {exc} ; détection des runners avec la configuration par défaut", file=sys.stderr)
        cfg = json.loads(json.dumps(DEFAULTS))
    status, _ = probe_runners(cfg, ADAPTERS)
    for r in ADAPTERS:
        print(f"runner {r} : " + (f"indisponible ({status[r]})" if status[r] else "installé et connecté"))
    current = cfg["default_runner"] if cfg.get("default_runner") in ADAPTERS else "claude"
    chosen = choose_default_runner(current, status)
    if chosen is None:
        print("avertissement : aucun runner utilisable ; default_runner inchangé "
              f"({current}). Installer/connecter {' ou '.join(ADAPTERS)} puis relancer `agent-runner init`.", file=sys.stderr)
        return None
    if not cfg_path.exists():
        return chosen
    text = cfg_path.read_text()
    if chosen != current:
        try:
            tomllib.loads(text)
        except tomllib.TOMLDecodeError:
            print(f"avertissement : {cfg_path} invalide, default_runner non modifié", file=sys.stderr)
            return chosen
        cfg_path.write_text(set_toml_key(text, "default_runner", chosen))
        print(f"default_runner : {current} -> {chosen} ({current} {status[current]})")
    else:
        print(f"default_runner : {chosen} (inchangé)")
    return chosen


def agent_rules_block() -> str:
    return (
        f"{RULES_BEGIN}\n"
        "## agent-task-runner\n\n"
        "- Ne modifie jamais `.agent-tasks/` (file de tâches gérée par `agent-runner`).\n"
        "- Utilise `file-outline <fichier>` pour repérer les plages de lignes exactes avant de lire un fichier entier.\n"
        "- Pour déplacer un gros bloc de lignes (300+) entre fichiers, utilise "
        "`move-lines <src> <début> <fin> <dst>` au lieu de réécrire le code.\n"
        f"{RULES_END}\n"
    )


def inject_rules(path: Path, create: bool) -> bool:
    if not path.exists():
        if not create:
            return False
        path.write_text(agent_rules_block())
        return True
    text = path.read_text()
    block = agent_rules_block()
    pat = re.compile(re.escape(RULES_BEGIN) + r".*?" + re.escape(RULES_END) + r"\n?", re.S)
    new = pat.sub(lambda _m: block, text) if pat.search(text) else text.rstrip("\n") + "\n\n" + block
    if new != text:
        path.write_text(new)
    return True


def update_config_file(cfg_path: Path) -> list[str]:
    """Ajoute les sections `[routing*]` manquantes dans un config.toml existant sans écraser l'existant."""
    text = cfg_path.read_text()
    try:
        parsed = tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        raise Fail(f"{cfg_path} : TOML invalide : {exc}") from exc
    routing = parsed.get("routing") if isinstance(parsed.get("routing"), dict) else {}
    added: list[str] = []
    chunks: list[str] = []
    if "level_runner" not in routing:
        added.append("routing.level_runner")
        chunks.append(
            "\n# Routage dynamique par niveau (fiches avec `level: N1|N2|N3` sans `runner` épinglé)\n"
            "[routing.level_runner]\nN1 = \"agy\"\nN2 = \"agy\"\nN3 = \"claude\"\n"
        )
    if "quota_threshold" not in routing:
        added.append("routing.quota_threshold")
        chunks.append(
            "\n[routing.quota_threshold]\nclaude = 80.0\nagy = 80.0\ncodex = 80.0\n"
        )
    if not any(k in routing for k in ("reset_grace_min", "usage_refresh_sec", "usage_refresh_tasks")):
        added.append("routing")
        chunks.append(
            "\n[routing]\n"
            "reset_grace_min = 20       # relâche le seuil si le reset est imminent (<= N min) et quota < 95%\n"
            "usage_refresh_sec = 300    # intervalle minimal (s) entre deux interrogations de quota en cours de run\n"
            "usage_refresh_tasks = 5    # rafraîchissement paresseux toutes les N tâches\n"
        )
    if chunks:
        sep = "" if not text or text.endswith("\n") else "\n"
        cfg_path.write_text(text + sep + "".join(chunks))
    return added


def cmd_init(args) -> int:
    root = repo_root()
    base = root / TASKS_DIR
    for d in ("todo", "done", "failed", "logs"):
        (base / d).mkdir(parents=True, exist_ok=True)
    example = base / "todo" / "00-example.md.disabled"
    if not example.exists():
        shutil.copy(TOOL_ROOT / "templates" / "example-task.md", example)

    if args.gitignore:
        target = root / ".gitignore"
    else:
        target = Path(git("rev-parse", "--git-path", "info/exclude", cwd=root).stdout.strip())
        if not target.is_absolute():
            target = root / target
        target.parent.mkdir(parents=True, exist_ok=True)
    existing = target.read_text() if target.exists() else ""
    if not any(ln.strip() in (".agent-tasks/", ".agent-tasks", "/.agent-tasks/", "/.agent-tasks") for ln in existing.splitlines()):
        with target.open("a") as fh:
            fh.write(("" if not existing or existing.endswith("\n") else "\n") + ".agent-tasks/\n")

    cfg_path = base / "config.toml"
    default_runner = configure_default_runner(root, cfg_path)
    if not cfg_path.exists():
        main = next((b for b in ("main", "master") if branch_exists(root, b)), "main")
        verify, tools = detect_stack(root)
        cfg_path.write_text(render_config(main, verify, tools, default_runner or "claude"))
        print(f"config.toml généré (default_runner : {default_runner or 'claude'}, verify par défaut : {verify or '-'})")
    elif args.update_config:
        added = update_config_file(cfg_path)
        if added:
            print(f"config.toml complété ({', '.join(added)})")
        else:
            print("config.toml déjà à jour")
    if args.with_agent_rules:
        inject_rules(root / "CLAUDE.md", create=True)
        inject_rules(root / "AGENTS.md", create=False)
        print("consignes ajoutées à CLAUDE.md (et AGENTS.md s'il existe)")
    print(f"{TASKS_DIR}/ initialisé dans {root}")
    return 0


